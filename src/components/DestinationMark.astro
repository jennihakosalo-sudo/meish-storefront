---
/** Destination marks — the same object appears on the homepage node and on the page it opens. */
interface Props {
  kind: 'business' | 'you' | 'tools' | 'contact';
  size?: 'node' | 'page';
}
const { kind, size = 'node' } = Astro.props;
---

<span class:list={['mark', `mark--${kind}`, `mark--${size}`]} aria-hidden="true">
  {kind === 'business' && (
    <svg viewBox="0 0 48 48" fill="none">
      <rect x="8" y="10" width="32" height="28" rx="1.5" stroke="#020C59" stroke-width="1.2" />
      <path d="M14 32 L22 20 L30 26 L36 16" stroke="#695EDB" stroke-width="1.3" />
      <circle cx="22" cy="20" r="1.6" fill="#FBD79F" />
      <circle cx="36" cy="16" r="1.6" fill="#020C59" />
      <path d="M14 14 H34" stroke="#020C59" stroke-opacity="0.25" stroke-width="1" />
    </svg>
  )}
  {kind === 'you' && (
    <svg viewBox="0 0 48 48" fill="none">
      <circle cx="24" cy="24" r="14" fill="url(#you-moon)" stroke="#FBD79F" stroke-width="1" />
      <circle cx="18" cy="18" r="4.5" fill="#FFFBF5" opacity="0.55" />
      <polygon points="33,12 36,18 33,24 30,18" fill="#695EDB" opacity="0.85" />
      <defs>
        <radialGradient id="you-moon" cx="38%" cy="34%" r="70%">
          <stop offset="0%" stop-color="#FFFBF5" />
          <stop offset="55%" stop-color="#E4D7F4" />
          <stop offset="100%" stop-color="#9b93e4" />
        </radialGradient>
      </defs>
    </svg>
  )}
  {kind === 'tools' && (
    <svg viewBox="0 0 48 48" fill="none">
      <circle cx="24" cy="24" r="15" stroke="#020C59" stroke-width="1" stroke-opacity="0.35" />
      <polygon points="24,8 34,22 24,40 14,22" fill="#FBD79F" />
      <polygon points="24,8 34,22 24,24" fill="#d4cef6" />
      <polygon points="24,40 34,22 24,24" fill="#e8c78a" />
    </svg>
  )}
  {kind === 'contact' && (
    <svg viewBox="0 0 48 48" fill="none">
      <rect x="10" y="14" width="28" height="20" rx="1.5" stroke="#020C59" stroke-width="1.2" />
      <path d="M10 16 L24 26 L38 16" stroke="#695EDB" stroke-width="1.2" />
      <circle cx="24" cy="8" r="1.4" fill="#FBD79F" />
    </svg>
  )}
</span>

<style>
  .mark { display: grid; place-items: center; }
  .mark svg { width: 100%; height: auto; display: block; }
  .mark--node { width: 1.55rem; }
  .mark--page { width: 2.4rem; }
</style>
