---
/** Same canonical diamond as the homepage doors. Size only. */
interface Props {
  size?: 'node' | 'page';
}
const { size = 'page' } = Astro.props;
---

<img
  class:list={['mark', `mark--${size}`]}
  src="/brand/meish-diamond-universe.jpg"
  alt=""
  width="360"
  height="540"
/>

<style>
  .mark {
    display: block;
    height: auto;
    mix-blend-mode: multiply;
  }
  .mark--node { width: 1.55rem; }
  .mark--page { width: 2.4rem; }
</style>
