---
/**
 * Intensive upright diamond — Deep Space surfaces only.
 * Transparent RGBA PNG. Never use on cream pages as a boxed mark.
 */
interface Props {
  size?: 'node' | 'page';
}
const { size = 'page' } = Astro.props;
---

<img
  class:list={['mark', `mark--${size}`]}
  src="/brand/meish-diamond-intensive-720.png"
  alt=""
  width="434"
  height="720"
  loading="lazy"
  decoding="async"
/>

<style>
  .mark {
    display: block;
    height: auto;
    transform: none;
    background: transparent;
    border: 0;
    padding: 0;
  }
  .mark--node { width: 1.55rem; }
  .mark--page { width: 2.4rem; }
</style>
