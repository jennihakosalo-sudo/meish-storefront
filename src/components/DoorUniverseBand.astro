---
/**
 * Subpage intro band — Brand Guide left (Light) + right (Transparent) diamonds
 * on Deep Space. Homepage keeps Intensive (middle) only.
 */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="door-band">
  <div class="door-band__sky" aria-hidden="true">
    <div class="door-band__gas door-band__gas--amethyst"></div>
    <div class="door-band__gas door-band__gas--fluorite"></div>
  </div>
  <img
    class="door-band__gem door-band__gem--left"
    src="/brand/meish-diamond-light.png"
    alt=""
    width="257"
    height="640"
    decoding="async"
  />
  <img
    class="door-band__gem door-band__gem--right"
    src="/brand/meish-diamond-transparent.png"
    alt=""
    width="285"
    height="640"
    decoding="async"
  />
  <div class="door-band__copy container">
    <p class="door-band__eyebrow">{eyebrow}</p>
    <h1 class="door-band__title">{title}</h1>
    {lead && <p class="door-band__lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .door-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #0b1020;
    color: #eaf6ff;
    padding: clamp(3.5rem, 8vw, 5.5rem) 0 clamp(2.5rem, 5vw, 3.5rem);
  }
  .door-band__sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .door-band__gas {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
  }
  .door-band__gas--amethyst {
    width: 42%;
    height: 70%;
    left: -8%;
    top: -20%;
    background: radial-gradient(circle, rgba(106, 90, 205, 0.35), transparent 70%);
  }
  .door-band__gas--fluorite {
    width: 40%;
    height: 65%;
    right: -10%;
    bottom: -25%;
    background: radial-gradient(circle, rgba(0, 195, 214, 0.22), transparent 72%);
  }
  .door-band__gem {
    position: absolute;
    z-index: 1;
    top: 50%;
    width: clamp(4.5rem, 11vw, 7.5rem);
    height: auto;
    transform: translateY(-50%);
    pointer-events: none;
    background: transparent;
    border: 0;
    filter: drop-shadow(0 8px 28px rgba(0, 195, 214, 0.22));
  }
  .door-band__gem--left {
    left: clamp(0.5rem, 3vw, 2.5rem);
  }
  .door-band__gem--right {
    right: clamp(0.5rem, 3vw, 2.5rem);
  }
  .door-band__copy {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 44rem;
  }
  .door-band__eyebrow {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #00c3d6;
    margin: 0;
  }
  .door-band__title {
    margin: 0.55rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 2.85rem);
    font-weight: 700;
    line-height: 1.05;
    color: #eaf6ff;
  }
  .door-band__lead {
    margin: 0.85rem auto 0;
    max-width: 42ch;
    font-size: 1.05rem;
    line-height: 1.5;
    color: rgba(234, 246, 255, 0.82);
  }
  @media (max-width: 700px) {
    .door-band__gem {
      width: 3.4rem;
      opacity: 0.85;
    }
    .door-band__copy {
      padding-inline: 3.5rem;
    }
  }
</style>
