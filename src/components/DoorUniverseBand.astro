---
/**
 * Inner-page intro — same light editorial world as the homepage.
 * One Diamond. No starfield, no dual gems, no leftover Universe theatre.
 */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="door-band">
  <div class="door-band__inner container">
    <img
      class="door-band__gem"
      src="/brand/meish-diamond-light.png"
      alt=""
      width="257"
      height="640"
      decoding="async"
    />
    <div class="door-band__copy">
      <p class="door-band__eyebrow">{eyebrow}</p>
      <h1 class="door-band__title">{title}</h1>
      {lead && <p class="door-band__lead">{lead}</p>}
      <slot />
    </div>
  </div>
</header>

<style>
  .door-band {
    background: var(--color-ivory);
    color: var(--color-navy);
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(2.25rem, 5vw, 3.5rem);
  }
  .door-band__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 40rem);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    min-width: 0;
  }
  .door-band__gem {
    width: min(5.5rem, 18vw);
    height: auto;
    background: transparent;
  }
  .door-band__eyebrow {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .door-band__title {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.625rem, 5vw, 3.75rem);
    font-weight: 600;
    font-style: normal;
    line-height: 1.12;
    color: var(--color-navy);
    max-width: 16ch;
    overflow-wrap: break-word;
  }
  .door-band__copy {
    min-width: 0;
  }
  .door-band__lead {
    margin: 0.9rem 0 0;
    max-width: 36rem;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-navy);
    overflow-wrap: break-word;
  }
  :global(.door-band-langs) {
    margin: 0.85rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: none;
  }
  @media (max-width: 700px) {
    .door-band__inner {
      grid-template-columns: 1fr;
    }
    .door-band__gem {
      width: min(4.5rem, 22vw);
    }
  }
</style>
