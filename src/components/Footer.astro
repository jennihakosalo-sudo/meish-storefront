---
const year = 2026;
---

<footer class="site-footer">
  <div class="container container--wide grid">
    <div>
      <p class="wordmark">Meish</p>
      <p class="blurb">Human experience is our North Star. We specialise in making work and life clearer, smoother and more useful.</p>
    </div>
    <nav aria-label="Universe">
      <p class="col-title">Universe</p>
      <ul>
        <li><a href="/#review">Reviewing Human Experience</a></li>
        <li><a href="/#business">Meish for Your Business</a></li>
        <li><a href="/#gifts">Meish Gifts</a></li>
        <li><a href="/#tools">Meish Tools</a></li>
      </ul>
    </nav>
    <nav aria-label="Contact">
      <p class="col-title">Contact</p>
      <ul>
        <li><a href="mailto:jenni@meish.work">jenni@meish.work</a></li>
        <li><a href="/contact">Get in touch</a></li>
        <li><a href="/shop">Meish Printed shop</a></li>
      </ul>
    </nav>
  </div>
  <div class="container container--wide baseline">
    <p>© {year} Meish. All rights reserved.</p>
    <p>Made on <a href="https://meish.work">meish.work</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4xl);
    background: var(--bg-alt);
    border-top: var(--border-hair);
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-lg);
    color: var(--text);
    margin-bottom: var(--space-sm);
  }
  .blurb { color: var(--text-muted); font-size: var(--text-sm); max-width: 42ch; }
  .col-title {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }
  nav ul { list-style: none; padding: 0; display: grid; gap: var(--space-xs); }
  nav a { color: var(--text-soft); font-size: var(--text-sm); }
  nav a:hover { color: var(--accent); }
  .baseline {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: var(--border-hair);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }
  .baseline a { color: var(--text-muted); }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; gap: var(--space-lg); }
    .baseline { flex-direction: column; }
  }
</style>
