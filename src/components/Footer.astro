---
import { nav, brand, CONTACT_EMAIL, mailTo } from '../data/site-content';

const year = 2026;
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <p class="wordmark">Meish</p>
      <p class="blurb">{brand.line}</p>
      <p class="blurb blurb--langs">We work in English and Finnish.</p>
    </div>

    <nav aria-label="Site">
      <p class="col-title">Meish</p>
      <ul>
        {nav.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>

    <div>
      <p class="col-title">Get in touch</p>
      {/* The address is written out, not hidden behind a word. Someone reading
          on a phone should be able to copy it into their own mail client. */}
      <p class="address"><a href={mailTo('Meish')}>{CONTACT_EMAIL}</a></p>
    </div>
  </div>

  <div class="container baseline">
    <p>© {year} Meish. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4xl);
    background: var(--bg-alt);
    border-top: var(--border-hair);
    padding-block: var(--space-2xl) var(--space-lg);
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-lg);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-lg);
    color: var(--text);
    margin-bottom: var(--space-sm);
  }
  .blurb {
    color: var(--text-soft);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 34ch;
  }
  .blurb--langs {
    margin-top: 0.4rem;
    color: var(--text-muted);
    font-size: 1rem;
  }
  .col-title {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }
  nav ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-soft);
    font-size: 1.0625rem;
  }
  .address a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1.125rem;
    color: var(--text);
    box-shadow: inset 0 -1px 0 rgba(11, 16, 32, 0.3);
  }
  a:hover {
    color: var(--accent);
  }
  .baseline {
    padding-top: var(--space-md);
    border-top: var(--border-hair);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 780px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
