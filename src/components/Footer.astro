---
import {
  hatchlingNav,
  fitYouHref,
  fitYouLabel,
  fitBusinessHref,
  fitBusinessLabel,
  contactEmail,
  contactMeishHref,
  contactMeishLabel,
} from '../data/hatchling-nav';
import { meishMailto } from '../lib/meish-mailto';

interface Props {
  universeHome?: boolean;
}

const { universeHome = false } = Astro.props;

const year = 2026;
const footerMail = meishMailto({
  product: 'Contact',
  page: 'Footer',
  section: 'Contact',
  cta: 'Email',
});
---

<footer class:list={['site-footer', universeHome && 'site-footer--universe']}>
  <div class="container container--wide grid">
    <div>
      <p class="wordmark">Meish</p>
      <p class="blurb">
        Human experience is our North Star. We work in English and Finnish. Palvelemme myös
        suomeksi.
      </p>
    </div>
    <nav aria-label="Site">
      <p class="col-title">Meish</p>
      <ul>
        {hatchlingNav.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        <li><a href="/contact">Contact</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>
    <nav aria-label="Contact">
      <p class="col-title">Contact</p>
      <ul>
        <li><a href={contactMeishHref}>{contactMeishLabel}</a></li>
        <li><a href={footerMail}>{contactEmail}</a></li>
        <li><a href={fitYouHref}>{fitYouLabel}</a></li>
        <li><a href={fitBusinessHref}>{fitBusinessLabel}</a></li>
        <li><a href="/for-business">Business offers</a></li>
      </ul>
    </nav>
  </div>
  <div class="container container--wide baseline">
    <p>© {year} Meish. All rights reserved.</p>
    <p>Made on <a href="https://www.meish.work">meish.work</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4xl);
    background: var(--bg-alt);
    border-top: var(--border-hair);
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .site-footer--universe {
    margin-top: 0;
    background: #0b1020;
    border-top: 1px solid rgba(234, 246, 255, 0.12);
    color: #eaf6ff;
  }
  .site-footer--universe .wordmark,
  .site-footer--universe .col-title,
  .site-footer--universe a {
    color: #eaf6ff;
  }
  .site-footer--universe .blurb,
  .site-footer--universe .baseline {
    color: #6f87a8;
  }
  .site-footer--universe a:hover {
    color: #00c3d6;
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-lg);
    color: var(--text);
    margin-bottom: var(--space-sm);
  }
  .blurb { color: var(--text-muted); font-size: 1.125rem; line-height: 1.6; max-width: 42ch; }
  .col-title {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }
  nav ul { list-style: none; padding: 0; display: grid; gap: 0.15rem; }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-soft);
    font-size: 1.0625rem;
  }
  nav a:hover { color: var(--accent); }
  .baseline {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: var(--border-hair);
    color: var(--text-muted);
    font-size: 1rem;
  }
  .baseline a { color: var(--text-muted); }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; gap: var(--space-lg); }
    .baseline { flex-direction: column; }
  }
</style>
