---
// Four public doors — order locked per Brand Kit plan.
const links = [
  { href: '/#review', label: 'Review' },
  { href: '/#business', label: 'Business' },
  { href: '/#gifts', label: 'Gifts' },
  { href: '/#tools', label: 'Tools' },
];
const path = Astro.url.pathname;
const hash = Astro.url.hash;
---

<header class="site-header">
  <div class="container container--wide bar">
    <a href="/" class="wordmark" aria-label="Meish — home">
      <img src="/brand/meish-universe-lockup-cream.png" alt="Meish" class="wordmark__img" width="120" height="32" />
    </a>
    <nav aria-label="Primary">
      <ul class="nav">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav__link"
              aria-current={path === '/' && hash === l.href.slice(1) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="/#business" class="button button--primary header-cta">Possibility Map</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: var(--border-hair);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    min-height: 4.5rem;
  }
  .wordmark {
    margin-right: auto;
    display: flex;
    align-items: center;
  }
  .wordmark:hover { text-decoration: none; }
  .wordmark__img {
    height: 2rem;
    width: auto;
  }
  .nav {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
  }
  .nav__link {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-soft);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--text);
    text-decoration: none;
  }
  .nav__link[aria-current='page'] { border-bottom: 2px solid var(--accent); }

  @media (max-width: 640px) {
    .header-cta { display: none; }
    .bar { gap: var(--space-md); min-height: 3.75rem; }
    .nav { gap: var(--space-sm); }
    .nav__link { font-size: var(--text-xs); }
  }
</style>
