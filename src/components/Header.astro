---
import { pathwayNav, becomeBetterHref, becomeBetterLabel } from '../data/hatchling-nav';

interface Props {
  universeHome?: boolean;
}

const { universeHome = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  if (href.startsWith('/#')) return false;
  const dest = href.replace(/\/$/, '') || '/';
  return dest !== '/' && path === dest;
}
---

<header class:list={['site-header', universeHome && 'site-header--home']}>
  <div class="container container--wide bar">
    <a href="/" class="wordmark" aria-label="Meish — home">
      <img src="/brand/meish-diamond-light.png" alt="" width="22" height="55" />
      <span>Meish</span>
    </a>

    <nav class="nav-desktop" aria-label="Pathways">
      <ul class="nav">
        {pathwayNav.map((l) => (
          <li>
            <a href={l.href} class:list={['nav__link', isActive(l.href) && 'nav__link--active']}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-cta" href={becomeBetterHref}>{becomeBetterLabel}</a>

    <details class="nav-mobile">
      <summary>Menu</summary>
      <ul>
        {pathwayNav.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
        <li>
          <a href={becomeBetterHref}>{becomeBetterLabel}</a>
        </li>
      </ul>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-ivory) 94%, transparent);
    backdrop-filter: saturate(120%) blur(10px);
    border-bottom: 1px solid rgba(11, 16, 32, 0.08);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 4.5rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-right: auto;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: 1.35rem;
    color: var(--color-navy);
  }
  .wordmark img {
    width: 1.15rem;
    height: auto;
  }
  .wordmark:hover {
    text-decoration: none;
    color: var(--color-navy);
  }

  .nav {
    display: flex;
    gap: 1.35rem;
    list-style: none;
    padding: 0;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1.0625rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--color-navy);
  }
  .nav__link--active,
  .nav__link:hover {
    color: var(--color-navy);
    text-decoration: none;
    box-shadow: inset 0 -2px 0 var(--color-amethyst);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.45rem 0.95rem;
    font-size: 1.0625rem;
    color: #fff;
    background: var(--color-navy);
    border: 1px solid var(--color-navy);
  }
  .header-cta:hover {
    color: #fff;
    background: #1a2438;
    text-decoration: none;
  }
  .header-cta:hover {
    text-decoration: none;
    border-color: var(--color-navy);
  }

  .nav-mobile {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-desktop,
    .header-cta {
      display: none;
    }
    .nav-mobile {
      display: block;
    }
    .nav-mobile summary {
      min-height: 2.75rem;
      min-width: 2.75rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 0.85rem;
      font-size: 1rem;
      cursor: pointer;
      list-style: none;
      border: 1px solid rgba(11, 16, 32, 0.28);
    }
    .nav-mobile summary::-webkit-details-marker {
      display: none;
    }
    .nav-mobile ul {
      position: absolute;
      right: var(--gutter);
      left: var(--gutter);
      margin: 0.5rem 0 0;
      padding: 0.75rem 1rem;
      list-style: none;
      background: var(--color-ivory);
      border: 1px solid rgba(11, 16, 32, 0.12);
    }
    .nav-mobile a {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      font-size: 1.0625rem;
      color: var(--color-navy);
    }
  }
</style>
