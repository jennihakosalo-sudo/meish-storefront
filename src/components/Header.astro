---
import { orbitGroups } from '../data/meish-offers';

interface Props {
  universeHome?: boolean;
}

const { universeHome = false } = Astro.props;

const links = orbitGroups.map((g) => ({
  href: g.href,
  label: g.shortLabel,
}));
---

<header class:list={['site-header', universeHome && 'site-header--universe']}>
  <div class="container container--wide bar">
    <a href="/" class="wordmark" aria-label="Meish — home">
      <img src="/brand/meish-universe-lockup-cream.png" alt="Meish" class="wordmark__img" width="140" height="36" />
    </a>
    <nav aria-label="Primary">
      <ul class="nav">
        {links.map((l) => (
          <li>
            <a href={l.href} class="nav__link">{l.label}</a>
          </li>
        ))}
        <li>
          <a href="#products" class="nav__link">Offers</a>
        </li>
      </ul>
    </nav>
    <a href="mailto:jenni@meish.work?subject=Meish%20AI%20Fit%20Check" class="button button--primary header-cta">Fit Check</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: var(--border-hair);
  }

  .site-header--universe {
    position: absolute;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, rgba(255, 251, 245, 0.92) 0%, rgba(255, 251, 245, 0.45) 70%, transparent 100%);
    backdrop-filter: blur(8px);
    border-bottom: none;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    min-height: 4.5rem;
  }

  .wordmark {
    margin-right: auto;
    display: flex;
    align-items: center;
  }
  .wordmark:hover { text-decoration: none; }
  .wordmark__img { height: 2.25rem; width: auto; }

  .nav {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  .nav__link {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--text-soft);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nav__link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .site-header--universe .header-cta {
    background: #020C59;
    border: 1px solid rgba(251, 215, 159, 0.25);
  }

  @media (max-width: 640px) {
    .header-cta { display: none; }
    .bar { gap: var(--space-sm); min-height: 3.75rem; }
    .nav { gap: var(--space-xs); }
    .nav__link { font-size: 0.6rem; letter-spacing: 0.08em; }
  }
</style>
