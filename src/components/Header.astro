---
import { hatchlingNav, contactMeishHref, contactMeishLabel } from '../data/hatchling-nav';

interface Props {
  universeHome?: boolean;
}

const { universeHome = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class:list={['site-header', universeHome && 'site-header--universe']}>
  <div class="container container--wide bar">
    <a href="/" class="wordmark" aria-label="Meish — home">Meish</a>
    <nav aria-label="Utility">
      <ul class="nav">
        {hatchlingNav.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={['nav__link', path === l.href && 'nav__link--active']}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {!universeHome && (
      <a href={contactMeishHref} class="header-cta">{contactMeishLabel}</a>
    )}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: var(--border-hair);
  }

  .site-header--universe {
    position: absolute;
    left: 0;
    right: 0;
    background: linear-gradient(
      180deg,
      rgba(5, 5, 16, 0.9) 0%,
      rgba(5, 5, 16, 0.28) 70%,
      transparent 100%
    );
    backdrop-filter: blur(8px);
    border-bottom: none;
  }
  .site-header--universe .wordmark,
  .site-header--universe .nav__link {
    color: #eaf6ff;
  }
  .site-header--universe .wordmark:hover,
  .site-header--universe .nav__link:hover,
  .site-header--universe .nav__link--active {
    color: #00c3d6;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    min-height: 4.5rem;
  }

  .wordmark {
    margin-right: auto;
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: 1.15rem;
    color: var(--color-navy);
  }
  .wordmark:hover {
    text-decoration: none;
    color: var(--color-navy);
  }

  .nav {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }
  .nav__link {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--text-soft);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav__link--active {
    color: var(--text);
  }
  .nav__link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .header-cta {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--color-navy);
    text-transform: none;
  }
  .header-cta:hover {
    text-decoration: none;
    color: var(--color-navy);
  }

  .site-header--universe .nav {
    opacity: 0.72;
  }

  @media (max-width: 768px) {
    .header-cta {
      display: none;
    }
    .bar {
      flex-wrap: wrap;
      gap: 0.45rem 0.75rem;
      min-height: 3.75rem;
      align-items: center;
      padding-top: 0.75rem;
      padding-bottom: 0.65rem;
    }
    .wordmark {
      margin-right: 0;
    }
    .nav {
      flex: 1 1 100%;
      gap: 0.4rem 0.85rem;
      flex-wrap: wrap;
      justify-content: flex-start;
      max-width: none;
    }
    .nav__link {
      font-size: 0.68rem;
      letter-spacing: 0.05em;
    }
  }
</style>
