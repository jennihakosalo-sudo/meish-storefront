---
import { nav, contactAction, brand } from '../data/site-content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  if (href.startsWith('/#') || href.startsWith('mailto:')) return false;
  const dest = href.replace(/\/$/, '') || '/';
  return dest !== '/' && path === dest;
}

---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="wordmark" aria-label="Meish — home">
      <img src={brand.diamond} alt="" width="360" height="540" />
      <span>Meish</span>
    </a>

    <nav aria-label="Main">
      <ul class="nav">
        {nav.map((l) => (
          <li>
            <a href={l.href} class:list={['nav__link', isActive(l.href) && 'nav__link--active']}>
              {l.prefix && <span class="nav__for">{l.prefix}</span>}
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a class="nav__link nav__link--cta" href={contactAction.href}>{contactAction.label}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-ivory) 94%, transparent);
    backdrop-filter: saturate(120%) blur(10px);
    border-bottom: 1px solid rgba(11, 16, 32, 0.08);
  }

  .bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    min-height: 4.75rem;
    padding-block: 0.35rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: 1.625rem;
    letter-spacing: 0.005em;
    color: var(--color-navy);
  }
  .wordmark img {
    height: 2.35rem;
    width: auto;
  }
  .wordmark:hover {
    text-decoration: none;
    color: var(--color-navy);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    min-height: 2.75rem;
    font-size: 1.0625rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--color-navy);
  }
  .nav__for {
    font-size: 0.7em;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-navy) 62%, transparent);
  }
  .nav__link--active,
  .nav__link:hover {
    color: var(--color-navy);
    text-decoration: none;
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .nav__link--cta {
    padding: 0.5rem 1.1rem;
    color: #ffffff;
    background: #13254a;
    border: 1px solid #7548d8;
  }
  .nav__link--cta:hover {
    color: #ffffff;
    background: #13254a;
    border-color: #7548d8;
    box-shadow: none;
  }

  @media (max-width: 780px) {
    .bar {
      min-height: 4.25rem;
    }
    .wordmark {
      font-size: 1.35rem;
    }
    .wordmark img {
      height: 1.9rem;
    }
    .nav {
      width: 100%;
      justify-content: flex-start;
      gap: 0.1rem 0.9rem;
    }
    .nav__link {
      min-height: 2.4rem;
      font-size: 0.875rem;
    }
    .nav__link--cta {
      padding: 0.3rem 0.7rem;
    }
  }

  @media (max-width: 375px) {
    .nav {
      gap: 0.05rem 0.7rem;
    }
    .nav__link {
      font-size: 0.8125rem;
    }
  }
</style>
