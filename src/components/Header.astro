---
import { hatchlingNav, fitCheckHref } from '../data/hatchling-nav';

interface Props {
  universeHome?: boolean;
}

const { universeHome = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class:list={['site-header', universeHome && 'site-header--universe']}>
  <div class="container container--wide bar">
    <a href="/" class="wordmark" aria-label="Meish — home">
      <img src="/brand/meish-universe-lockup-cream.png" alt="Meish" class="wordmark__img" width="140" height="36" />
    </a>
    <nav aria-label="Primary">
      <ul class="nav">
        {hatchlingNav.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={['nav__link', path === l.href && 'nav__link--active']}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={fitCheckHref} class="button button--primary header-cta">Fit Check</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: var(--border-hair);
  }

  .site-header--universe {
    position: absolute;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, rgba(255, 251, 245, 0.92) 0%, rgba(255, 251, 245, 0.45) 70%, transparent 100%);
    backdrop-filter: blur(8px);
    border-bottom: none;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    min-height: 4.5rem;
  }

  .wordmark {
    margin-right: auto;
    display: flex;
    align-items: center;
  }
  .wordmark:hover { text-decoration: none; }
  .wordmark__img { height: 2.25rem; width: auto; }

  .nav {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  .nav__link {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--text-soft);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav__link--active {
    color: var(--text);
  }

  .nav__link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .site-header--universe .header-cta {
    background: #020C59;
    border: 1px solid rgba(251, 215, 159, 0.25);
  }

  @media (max-width: 768px) {
    .header-cta { display: none; }
    .bar { gap: var(--space-sm); min-height: 3.75rem; }
    .nav { gap: var(--space-xs); flex-wrap: wrap; justify-content: flex-end; }
    .nav__link { font-size: 0.58rem; letter-spacing: 0.06em; }
  }
</style>
