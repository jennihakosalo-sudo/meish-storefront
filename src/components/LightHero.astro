---
/**
 * Page hero, used by the homepage and by each subpage that has a photograph.
 *
 * Full-bleed image with the copy set over it in HTML, so the words stay sharp,
 * selectable and responsive rather than being baked into pixels. The image runs
 * edge to edge at every width; the copy stays inside the same content column as
 * every section below it, so the left edge of the page never moves.
 *
 * Height follows the content. Full width does not mean full viewport height —
 * a visitor should see that there is a page underneath without scrolling.
 *
 * The heading is always the page's h1: this replaces the text-only opening
 * band the subpages used to carry, rather than sitting above it.
 */
import { hero } from '../data/site-content';

/**
 * A photograph in the two crops it was built in, with the widths that exist on
 * disk for each. Sources and widths travel together: a source without its own
 * widths would build a srcset pointing at files for a different photograph.
 * Built by scripts/hero-images.mjs; assembled by `heroImages` in site-content.
 */
interface HeroImage {
  /** Landscape source, used from 40rem up. This is the fallback and the largest. */
  landscape: string;
  landscapeWidths?: number[];
  /** Portrait source for phones, where a 16:9 crop loses the subject. */
  portrait: string;
  portraitWidths?: number[];
  /**
   * How dark the scrim over the image is. Photographs differ: a bright lobby
   * needs more cover than a dusk interior. 0 leaves the image untouched.
   */
  scrim: number;
  alt?: string;
}

interface Props {
  /** Small line above the heading. Says who the page is for. */
  eyebrow?: string;
  /** The page's h1. */
  line?: string;
  lead?: string;
  /**
   * One action, or none. The homepage needs somewhere to send a visitor who
   * has arrived at a slogan; a subpage does not, because the page under the
   * image is already the answer.
   */
  action?: { label: string; href: string } | null;
  image?: HeroImage;
  /** Every hero is the first thing on its page, so this is on by default. */
  priority?: boolean;
  /**
   * Homepage-only size. Other pages must keep the default height — this
   * component is shared and a class here would change every hero at once.
   */
  modifier?: string;
}

const {
  eyebrow,
  line = hero.line,
  lead = hero.lead,
  action = hero.action,
  image = hero.image,
  priority = true,
  modifier,
} = Astro.props as Props;

const { landscape, portrait, scrim, alt = '' } = image;
const landscapeWidths = image.landscapeWidths ?? [];
const portraitWidths = image.portraitWidths ?? [];

/** `/images/hero/walkthrough-landscape-1280.webp` + 640 → the 640 file. */
const srcset = (src: string, widths: number[]) =>
  widths.length
    ? widths.map((w) => `${src.replace(/-\d+\.webp$/, `-${w}.webp`)} ${w}w`).join(', ')
    : undefined;

const landscapeSet = srcset(landscape, landscapeWidths);
const portraitSet = srcset(portrait, portraitWidths);
---

<section class:list={['hero', modifier]} style={`--scrim: ${scrim}`}>
  <picture class="hero__media">
    <!-- The image is full-bleed at every width, so sizes is simply the viewport. -->
    <source media="(max-width: 40rem)" srcset={portraitSet ?? portrait} sizes="100vw" />
    <img
      src={landscape}
      srcset={landscapeSet}
      sizes="100vw"
      alt={alt}
      width="1280"
      height="720"
      fetchpriority={priority ? 'high' : 'auto'}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
    />
  </picture>

  <div class="hero__inner container">
    {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
    <h1 class="hero__line">{line}</h1>
    <p class="hero__lead">{lead}</p>
    {
      action && (
        <p class="hero__actions">
          <a class="button button--hero" href={action.href}>
            {action.label}
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    /* One cell: image and copy occupy the same grid area, so the section is as
       tall as whichever is taller and no absolute positioning is needed. */
    grid-template-areas: 'stack';
    align-items: end;
    min-height: clamp(26rem, 60vh, 38rem);
    isolation: isolate;
    background: var(--color-navy);
  }

  .hero__media,
  .hero__inner {
    grid-area: stack;
  }

  .hero__media {
    position: relative;
    height: 100%;
    z-index: 0;
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    /* Cover crops rather than distorts. The focal point sits left of centre
       because that is where every one of the candidate images puts its
       subject, and it is the half that survives a narrow crop. */
    object-fit: cover;
    object-position: 38% 50%;
  }

  /* The scrim is a gradient rather than a flat tint: flat tint dulls the whole
     photograph to protect two lines of text that only sit at the bottom. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(26, 36, 51, calc(var(--scrim) * 1.05)) 0%,
      rgba(26, 36, 51, calc(var(--scrim) * 0.7)) 38%,
      rgba(26, 36, 51, calc(var(--scrim) * 0.22)) 72%,
      rgba(26, 36, 51, calc(var(--scrim) * 0.08)) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--color-ivory);
  }

  /* Sits above the headline and says who the page is for, so it has to be
     legible against the lightest part of the scrim without competing with the
     h1 underneath it. */
  .hero__eyebrow {
    margin: 0 0 0.9rem;
    max-width: 52ch;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.45;
    color: rgba(244, 239, 232, 0.82);
    text-shadow: 0 1px 18px rgba(7, 17, 31, 0.55);
  }

  .hero__line {
    margin: 0;
    max-width: 18ch;
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.008em;
    color: var(--color-ivory);
    text-wrap: balance;
    /* Insurance, not decoration. Five different photographs will sit behind
       this and the scrim cannot be tuned for all of them at once. */
    text-shadow: 0 1px 24px rgba(7, 17, 31, 0.45);
  }

  /* Headline, sentence and button read as one block: the sentence is close
     enough to the headline to belong to it, and the button close enough to the
     sentence to be its consequence. */
  .hero__lead {
    margin: 0.85rem 0 0;
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.5;
    color: rgba(244, 239, 232, 0.92);
    text-wrap: pretty;
    text-shadow: 0 1px 18px rgba(7, 17, 31, 0.5);
  }

  .hero__actions {
    margin: 1.4rem 0 0;
    max-width: none;
  }

  @media (max-width: 40rem) {
    .hero {
      min-height: clamp(24rem, 72vh, 34rem);
    }
    /* On a phone the crop is portrait already, so the subject is centred and
       the focal nudge is no longer needed. */
    .hero__media img {
      object-position: 50% 45%;
    }
    /* The portrait crops already end in floor or shadow where the copy sits,
       so the full scrim would stack darkness on darkness. */
    .hero__media::after {
      background: linear-gradient(
        to top,
        rgba(26, 36, 51, calc(var(--scrim) * 0.85)) 0%,
        rgba(26, 36, 51, calc(var(--scrim) * 0.55)) 45%,
        rgba(26, 36, 51, calc(var(--scrim) * 0.16)) 80%,
        rgba(26, 36, 51, calc(var(--scrim) * 0.06)) 100%
      );
    }
    .hero__inner {
      padding-block: clamp(2rem, 8vw, 3rem);
    }
    .hero__actions .button {
      width: 100%;
    }
  }

  /* Homepage only. Passed as `modifier` so Business / Space / Tools / About
     keep the default height. */
  .hero--home {
    min-height: clamp(32rem, 78vh, 48rem);
  }
  .hero--home .hero__media img {
    object-position: 42% 40%;
  }
  @media (max-width: 40rem) {
    .hero--home {
      min-height: clamp(28rem, 84vh, 42rem);
    }
    .hero--home .hero__media img {
      object-position: 50% 38%;
    }
  }
</style>
