---

<div class="meish-star">
  <div class="meish-star__radiance meish-star__radiance--lavender" aria-hidden="true" />
  <div class="meish-star__radiance meish-star__radiance--gold" aria-hidden="true" />
  <div class="meish-star__radiance meish-star__radiance--red" aria-hidden="true" />

  <img
    src="/brand/meish-universe-lockup-cream.png"
    alt="Meish Universe"
    class="meish-star__lockup-hero"
    width="472"
    height="1024"
    loading="eager"
    decoding="async"
  />
</div>
