---
/**
 * Meish Universe homepage — Intensive Brand Guide style.
 * Diamonds: ONLY public/brand/meish-diamond-intensive.png
 * Always upright (no tilt). Deep Space field + mineral palette.
 */
import { contactMeishHref, contactMeishLabel } from '../data/hatchling-nav';

const diamondSrc = '/brand/meish-diamond-intensive-720.png';

const destinations = [
  {
    href: '/for-business',
    name: 'Meish for Your Business',
    hint: 'Offers and Possibility Map',
    x: '15%',
    y: '30%',
    mx: '18%',
    my: '16%',
  },
  {
    href: '/for-you',
    name: 'Meish for You',
    hint: 'The personal side',
    x: '85%',
    y: '26%',
    mx: '82%',
    my: '14%',
  },
  {
    href: '/tools',
    name: 'Meish Tools',
    hint: 'Focused instruments',
    x: '84%',
    y: '72%',
    mx: '80%',
    my: '78%',
  },
  {
    href: '/gifts',
    name: 'Gifts for You',
    hint: 'Free downloads',
    x: '16%',
    y: '74%',
    mx: '20%',
    my: '84%',
  },
];
---

<section class="home" aria-label="Meish Universe">
  <div class="sky" aria-hidden="true">
    <div class="gas gas--amethyst"></div>
    <div class="gas gas--fluorite"></div>
    <div class="gas gas--gold"></div>
    <div class="gas gas--coral"></div>
    <div class="stars"></div>
    <svg class="orbits" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
      <ellipse cx="50" cy="42" rx="18" ry="14" />
      <ellipse cx="50" cy="42" rx="28" ry="21" />
      <ellipse cx="50" cy="42" rx="38" ry="29" />
    </svg>
  </div>

  <div class="depth">
    <nav class="orbit" aria-label="Universe destinations">
      {destinations.map((d) => (
        <a
          class="gem gem--hit"
          href={d.href}
          style={`--x:${d.x};--y:${d.y};--mx:${d.mx};--my:${d.my}`}
          aria-label={`${d.name}. ${d.hint}. Opens ${d.href}.`}
        >
          <img class="gem__face" src={diamondSrc} alt="" width="434" height="720" loading="lazy" decoding="async" />
          <span class="gem__label">
            <strong>{d.name}</strong>
          </span>
        </a>
      ))}
    </nav>

    <div class="hero">
      <div class="hero__crystal" aria-hidden="true">
        <img
          class="hero__diamond"
          src={diamondSrc}
          alt=""
          width="434"
          height="720"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <h1 class="hero__name">Meish</h1>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__realm">Universe</p>
      <p class="hero__north">Human experience is our North Star.</p>
      <p class="hero__langs">We work in English and Finnish. · Palvelemme myös suomeksi.</p>
      <p class="hero__lead">
        We notice things. Then we make useful things out of what we notice —
        tools, maps, reviews and changes for work and everyday life.
      </p>
      <p class="hero__ctas">
        <a class="hero__cta hero__cta--primary" href="/for-business">For Your Business</a>
        <a class="hero__cta hero__cta--ghost" href="/for-you">For You</a>
        <a class="hero__cta hero__cta--ghost" href={contactMeishHref}>{contactMeishLabel}</a>
      </p>
    </div>
  </div>

  <div class="floor">
    <a class="offer" href="/for-business#possibility-map">
      <span class="offer__kicker">For Your Business</span>
      <strong>Possibility Map</strong>
      <span class="offer__meta">€590 + VAT 25.5% · Gamma Test Phase</span>
    </a>
    <a class="offer offer--secondary" href={contactMeishHref}>
      <span class="offer__kicker">{contactMeishLabel}</span>
      <strong>moona.m@meish.work</strong>
      <span class="offer__meta">Tell us what should become better</span>
    </a>
  </div>
</section>

<style>
  .home {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: #0b1020;
    color: #eaf6ff;
    padding-bottom: 2.75rem;
  }

  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .gas {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }
  .gas--amethyst {
    width: 55%;
    height: 50%;
    left: -8%;
    top: 5%;
    background: radial-gradient(circle, rgba(106, 90, 205, 0.35) 0%, transparent 70%);
  }
  .gas--fluorite {
    width: 50%;
    height: 48%;
    right: -10%;
    top: 20%;
    background: radial-gradient(circle, rgba(0, 195, 214, 0.22) 0%, transparent 72%);
  }
  .gas--gold {
    width: 45%;
    height: 40%;
    left: 28%;
    top: 35%;
    background: radial-gradient(circle, rgba(247, 200, 115, 0.18) 0%, transparent 68%);
  }
  .gas--coral {
    width: 40%;
    height: 36%;
    left: 35%;
    bottom: 8%;
    background: radial-gradient(circle, rgba(255, 107, 107, 0.16) 0%, transparent 70%);
  }

  .stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1.2px 1.2px at 12% 22%, rgba(234, 246, 255, 0.55), transparent),
      radial-gradient(1px 1px at 28% 68%, rgba(234, 246, 255, 0.35), transparent),
      radial-gradient(1.4px 1.4px at 41% 18%, rgba(247, 200, 115, 0.7), transparent),
      radial-gradient(1px 1px at 61% 81%, rgba(234, 246, 255, 0.3), transparent),
      radial-gradient(1.3px 1.3px at 74% 26%, rgba(0, 195, 214, 0.55), transparent),
      radial-gradient(1px 1px at 91% 14%, rgba(234, 246, 255, 0.4), transparent),
      radial-gradient(1.2px 1.2px at 8% 48%, rgba(246, 184, 224, 0.45), transparent),
      radial-gradient(1px 1px at 53% 44%, rgba(234, 246, 255, 0.25), transparent);
  }

  .orbits {
    position: absolute;
    left: 50%;
    top: 8%;
    width: min(70vw, 520px);
    height: min(70vw, 520px);
    margin-left: calc(min(70vw, 520px) / -2);
    fill: none;
    stroke: rgba(234, 246, 255, 0.14);
    stroke-width: 0.35;
  }

  .depth {
    position: relative;
    height: min(90dvh, 820px);
    min-height: 580px;
  }

  .orbit {
    position: absolute;
    inset: 0;
  }

  .gem {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 4.8rem;
    margin-left: -2.4rem;
    margin-top: -2.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .gem__face {
    display: block;
    width: 100%;
    height: auto;
    background: transparent;
    border: 0;
    padding: 0;
    /* Always upright — never rotate diamonds */
    transform: none;
    filter: drop-shadow(0 8px 24px rgba(0, 195, 214, 0.25));
  }
  .gem:hover { text-decoration: none; color: inherit; }

  .gem--hit {
    width: 5.2rem;
    transition: filter 280ms cubic-bezier(0.4, 0, 0.15, 1), transform 280ms ease;
  }
  .gem--hit:hover,
  .gem--hit:focus-visible {
    outline: none;
    filter: brightness(1.12);
    transform: scale(1.06);
  }

  .gem__label {
    margin-top: 0.4rem;
    text-align: center;
  }
  .gem__label strong {
    display: block;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #eaf6ff;
    max-width: 14ch;
    text-shadow: 0 1px 8px rgba(11, 16, 32, 0.9);
  }

  .hero {
    position: absolute;
    left: 50%;
    top: 6%;
    width: min(36vw, 220px);
    margin-left: calc(min(36vw, 220px) / -2);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    pointer-events: none;
    z-index: 2;
  }
  .hero__crystal {
    width: 100%;
    position: relative;
  }
  .hero__diamond {
    display: block;
    width: 100%;
    height: auto;
    background: transparent;
    border: 0;
    padding: 0;
    transform: none;
    filter: drop-shadow(0 0 28px rgba(106, 90, 205, 0.45))
      drop-shadow(0 12px 40px rgba(255, 107, 107, 0.25));
  }
  .hero__name {
    margin: 0.65rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: #eaf6ff;
    max-width: none;
  }
  .hero__rule {
    display: block;
    width: 5rem;
    height: 1px;
    margin: 0.55rem 0 0.4rem;
    background: linear-gradient(90deg, transparent, #f7c873 18%, #f7c873 82%, transparent);
  }
  .hero__realm {
    font-size: 0.68rem;
    letter-spacing: 0.46em;
    text-transform: uppercase;
    color: #00c3d6;
    max-width: none;
  }
  .hero__north {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: #eaf6ff;
    max-width: 28ch;
  }
  .hero__lead {
    margin-top: 0.65rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.5;
    color: rgba(234, 246, 255, 0.78);
    max-width: 38ch;
  }
  .hero__langs {
    margin-top: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #6f87a8;
    max-width: 42ch;
  }
  .hero__ctas {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    pointer-events: auto;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
  }
  .hero__cta--primary {
    background: #6a5acd;
    color: #eaf6ff;
  }
  .hero__cta--primary:hover {
    text-decoration: none;
    color: #eaf6ff;
    opacity: 0.92;
  }
  .hero__cta--ghost {
    border: 1px solid rgba(234, 246, 255, 0.35);
    color: #eaf6ff;
    background: rgba(11, 16, 32, 0.45);
  }
  .hero__cta--ghost:hover {
    text-decoration: none;
    color: #eaf6ff;
    border-color: #00c3d6;
  }

  .floor {
    position: relative;
    z-index: 4;
    width: min(100% - 2.5rem, 760px);
    margin: 0.5rem auto 0;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
  }
  .offer {
    display: grid;
    gap: 0.28rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(234, 246, 255, 0.18);
    text-decoration: none;
    color: inherit;
  }
  .offer:hover { text-decoration: none; color: inherit; }
  .offer:hover strong { color: #00c3d6; }
  .offer__kicker {
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6f87a8;
  }
  .offer strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    max-width: 24ch;
    color: #eaf6ff;
    transition: color 200ms ease;
  }
  .offer--secondary strong {
    font-size: 1rem;
    font-weight: 500;
    max-width: 26ch;
  }
  .offer__meta {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 400;
    color: rgba(234, 246, 255, 0.72);
  }

  @media (max-width: 860px) {
    .depth {
      min-height: 520px;
      height: min(78dvh, 640px);
    }
    .gem--hit {
      left: var(--mx);
      top: var(--my);
      width: 4rem;
    }
    .gem__label strong {
      font-size: 0.52rem;
      max-width: 12ch;
    }
    .hero {
      width: min(52vw, 170px);
      margin-left: calc(min(52vw, 170px) / -2);
      top: 8%;
    }
    .hero__name {
      font-size: clamp(2rem, 9vw, 2.6rem);
    }
    .hero__lead { display: none; }
    .floor {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      width: min(100% - 2rem, 720px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gem--hit { transition: none; }
  }
</style>
