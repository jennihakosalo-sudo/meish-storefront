---
/**
 * Meish Universe homepage — full-viewport astronomical atlas composition.
 * Diamonds: ONLY public/brand/meish-diamond-universe.jpg (Brand Kit lock).
 * No new geometry. No SaaS hero CTAs.
 */
import { contactMeishHref, contactMeishLabel } from '../data/hatchling-nav';

const diamondSrc = '/brand/meish-diamond-universe.jpg';

/** Many small repetitions of the approved diamond at different depths. */
const dust = [
  { x: '6%', y: '12%', z: '-520px', s: '0.22', rz: '-18deg', o: '0.28' },
  { x: '14%', y: '22%', z: '-400px', s: '0.3', rz: '12deg', o: '0.34' },
  { x: '22%', y: '8%', z: '-560px', s: '0.18', rz: '-8deg', o: '0.24' },
  { x: '31%', y: '78%', z: '-380px', s: '0.26', rz: '22deg', o: '0.3' },
  { x: '8%', y: '62%', z: '-480px', s: '0.24', rz: '-32deg', o: '0.26' },
  { x: '18%', y: '48%', z: '-340px', s: '0.2', rz: '16deg', o: '0.22' },
  { x: '38%', y: '14%', z: '-500px', s: '0.16', rz: '-24deg', o: '0.2' },
  { x: '44%', y: '86%', z: '-420px', s: '0.28', rz: '10deg', o: '0.32' },
  { x: '52%', y: '6%', z: '-540px', s: '0.2', rz: '-14deg', o: '0.26' },
  { x: '58%', y: '72%', z: '-360px', s: '0.22', rz: '28deg', o: '0.28' },
  { x: '68%', y: '18%', z: '-460px', s: '0.26', rz: '-20deg', o: '0.3' },
  { x: '74%', y: '58%', z: '-320px', s: '0.18', rz: '8deg', o: '0.24' },
  { x: '82%', y: '10%', z: '-500px', s: '0.24', rz: '18deg', o: '0.28' },
  { x: '88%', y: '38%', z: '-440px', s: '0.3', rz: '-12deg', o: '0.34' },
  { x: '92%', y: '68%', z: '-380px', s: '0.22', rz: '24deg', o: '0.26' },
  { x: '78%', y: '84%', z: '-480px', s: '0.2', rz: '-28deg', o: '0.24' },
  { x: '64%', y: '42%', z: '-560px', s: '0.14', rz: '6deg', o: '0.18' },
  { x: '26%', y: '34%', z: '-580px', s: '0.15', rz: '-16deg', o: '0.18' },
  { x: '48%', y: '52%', z: '-600px', s: '0.12', rz: '20deg', o: '0.16' },
  { x: '12%', y: '88%', z: '-360px', s: '0.26', rz: '-10deg', o: '0.3' },
];

const destinations = [
  {
    href: '/for-business',
    name: 'Meish for Your Business',
    hint: 'Offers and Possibility Map',
    x: '15%',
    y: '30%',
    mx: '18%',
    my: '16%',
    z: '-60px',
    s: '0.58',
    rz: '-14deg',
  },
  {
    href: '/for-you',
    name: 'Meish for You',
    hint: 'The personal side',
    x: '85%',
    y: '26%',
    mx: '82%',
    my: '14%',
    z: '-120px',
    s: '0.5',
    rz: '16deg',
  },
  {
    href: '/tools',
    name: 'Meish Tools',
    hint: 'Focused instruments',
    x: '84%',
    y: '72%',
    mx: '80%',
    my: '78%',
    z: '-40px',
    s: '0.52',
    rz: '-12deg',
  },
  {
    href: '/gifts',
    name: 'Gifts for You',
    hint: 'Free downloads',
    x: '16%',
    y: '74%',
    mx: '20%',
    my: '84%',
    z: '-160px',
    s: '0.48',
    rz: '20deg',
  },
];
---

<section class="home" aria-label="Meish Universe">
  <div class="sky" aria-hidden="true">
    <div class="gas gas--gold"></div>
    <div class="gas gas--lavender"></div>
    <div class="gas gas--navy"></div>
    <div class="gas gas--core"></div>
    <div class="stars"></div>
    <svg class="chart" viewBox="0 0 100 100" preserveAspectRatio="none">
      <ellipse cx="50" cy="46" rx="22" ry="17" />
      <ellipse cx="50" cy="46" rx="34" ry="26" />
      <ellipse cx="50" cy="46" rx="46" ry="36" />
      <line x1="50" y1="4" x2="50" y2="92" />
      <line x1="6" y1="46" x2="94" y2="46" />
      <line x1="18" y1="14" x2="82" y2="78" />
      <line x1="82" y1="14" x2="18" y2="78" />
      <circle cx="50" cy="46" r="1.1" fill="rgba(2,12,89,0.2)" stroke="none" />
    </svg>
  </div>

  <div class="depth">
    {dust.map((g) => (
      <span
        class="gem gem--dust"
        style={`--x:${g.x};--y:${g.y};--z:${g.z};--s:${g.s};--rz:${g.rz};--o:${g.o}`}
      >
        <img class="gem__face" src={diamondSrc} alt="" width="360" height="540" />
      </span>
    ))}

    <nav class="orbit" aria-label="Universe destinations">
      {destinations.map((d) => (
        <a
          class="gem gem--hit"
          href={d.href}
          style={`--x:${d.x};--y:${d.y};--mx:${d.mx};--my:${d.my};--z:${d.z};--s:${d.s};--rz:${d.rz}`}
          aria-label={`${d.name}. ${d.hint}. Opens ${d.href}.`}
        >
          <img class="gem__face" src={diamondSrc} alt="" width="360" height="540" />
          <span class="gem__label">
            <strong>{d.name}</strong>
          </span>
        </a>
      ))}
    </nav>

    <div class="hero" style="--z:32px">
      <img
        class="hero__diamond"
        src={diamondSrc}
        alt=""
        width="360"
        height="540"
      />
      <p class="hero__name">Meish</p>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__realm">Universe</p>
      <p class="hero__north">Human experience is our North Star.</p>
      <p class="hero__langs">We work in English and Finnish. · Palvelemme myös suomeksi.</p>
      <p class="hero__lead">
        We specialise in human experience — understanding it, reviewing it and making it better.
        AI is a means. It serves human experience; Meish does not serve AI.
      </p>
      <p class="hero__ctas">
        <a class="hero__cta hero__cta--primary" href={contactMeishHref}>{contactMeishLabel}</a>
        <a class="hero__cta hero__cta--ghost" href="/for-business">Explore Meish</a>
      </p>
    </div>
  </div>

  <div class="floor">
    <a class="offer" href="/for-business#possibility-map">
      <span class="offer__kicker">For Your Business</span>
      <strong>Possibility Map</strong>
      <span class="offer__meta">€590 + VAT 25.5% · Gamma Test Phase</span>
    </a>
    <a class="offer offer--secondary" href={contactMeishHref}>
      <span class="offer__kicker">{contactMeishLabel}</span>
      <strong>moona.m@meish.work</strong>
      <span class="offer__meta">Tell us what should become better</span>
    </a>
  </div>
</section>

<style>
  .home {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: #fffbf5;
    color: #020c59;
    padding-bottom: 2.75rem;
  }

  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .gas {
    position: absolute;
    border-radius: 50%;
    filter: blur(72px);
  }
  .gas--gold {
    width: 78%;
    height: 62%;
    left: 12%;
    top: 18%;
    background: radial-gradient(circle, rgba(251, 215, 159, 0.62) 0%, transparent 68%);
  }
  .gas--lavender {
    width: 64%;
    height: 70%;
    left: -14%;
    top: 2%;
    background: radial-gradient(circle, rgba(105, 94, 219, 0.22) 0%, transparent 72%);
  }
  .gas--navy {
    width: 56%;
    height: 54%;
    right: -12%;
    bottom: 2%;
    background: radial-gradient(circle, rgba(2, 12, 89, 0.14) 0%, transparent 70%);
  }
  .gas--core {
    width: 42%;
    height: 42%;
    left: 29%;
    top: 28%;
    filter: blur(90px);
    background: radial-gradient(circle, rgba(251, 215, 159, 0.35) 0%, rgba(105, 94, 219, 0.12) 45%, transparent 70%);
  }

  .stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1.2px 1.2px at 12% 22%, rgba(2, 12, 89, 0.32), transparent),
      radial-gradient(1px 1px at 28% 68%, rgba(2, 12, 89, 0.22), transparent),
      radial-gradient(1.4px 1.4px at 41% 18%, rgba(251, 215, 159, 0.75), transparent),
      radial-gradient(1px 1px at 61% 81%, rgba(2, 12, 89, 0.24), transparent),
      radial-gradient(1.3px 1.3px at 74% 26%, rgba(251, 215, 159, 0.55), transparent),
      radial-gradient(1px 1px at 91% 14%, rgba(2, 12, 89, 0.26), transparent),
      radial-gradient(1.2px 1.2px at 8% 48%, rgba(251, 215, 159, 0.45), transparent),
      radial-gradient(1px 1px at 53% 44%, rgba(2, 12, 89, 0.18), transparent),
      radial-gradient(1.1px 1.1px at 36% 56%, rgba(251, 215, 159, 0.4), transparent),
      radial-gradient(0.9px 0.9px at 69% 61%, rgba(2, 12, 89, 0.2), transparent);
  }

  .chart {
    position: absolute;
    inset: 5%;
    width: 90%;
    height: 90%;
    fill: none;
    stroke: rgba(2, 12, 89, 0.11);
    stroke-width: 0.14;
  }

  .depth {
    position: relative;
    height: min(90dvh, 820px);
    min-height: 580px;
    perspective: 1200px;
  }

  .orbit {
    position: absolute;
    inset: 0;
  }

  .gem {
    --rz: 0deg;
    --s: 1;
    --o: 1;
    --z: 0px;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 4.8rem;
    margin-left: -2.4rem;
    margin-top: -2.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transform: translateZ(var(--z));
  }
  .gem__face {
    display: block;
    width: 100%;
    height: auto;
    transform: rotate(var(--rz)) scale(var(--s));
    opacity: var(--o);
    mix-blend-mode: multiply;
  }
  .hero__diamond {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .gem:hover { text-decoration: none; color: inherit; }

  .gem--dust {
    width: 2.6rem;
    pointer-events: none;
  }

  .gem--hit {
    width: 5.2rem;
    transition: filter 280ms cubic-bezier(0.4, 0, 0.15, 1);
  }
  .gem--hit:hover,
  .gem--hit:focus-visible {
    outline: none;
    filter: brightness(1.06);
  }

  .gem__label {
    margin-top: 0.35rem;
    text-align: center;
  }
  .gem__label strong {
    display: block;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #020c59;
    max-width: 14ch;
  }

  .hero {
    position: absolute;
    left: 50%;
    top: 10%;
    width: min(32vw, 200px);
    margin-left: calc(min(32vw, 200px) / -2);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    pointer-events: none;
    transform: translateZ(var(--z));
  }
  .hero__name {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: #020c59;
    max-width: none;
  }
  .hero__rule {
    display: block;
    width: 5rem;
    height: 1px;
    margin: 0.55rem 0 0.4rem;
    background: linear-gradient(90deg, transparent, #fbd79f 18%, #fbd79f 82%, transparent);
  }
  .hero__realm {
    font-size: 0.68rem;
    letter-spacing: 0.46em;
    text-transform: uppercase;
    color: #695edb;
    max-width: none;
  }
  .hero__north {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: #020c59;
    max-width: 28ch;
  }
  .hero__lead {
    margin-top: 0.65rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.5;
    color: #2a3568;
    max-width: 38ch;
  }
  .hero__langs {
    margin-top: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #5a6294;
    max-width: 42ch;
  }
  .hero__ctas {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
  }
  .hero__cta--primary {
    background: #020c59;
    color: #fffbf5;
  }
  .hero__cta--primary:hover {
    text-decoration: none;
    color: #fffbf5;
    opacity: 0.92;
  }
  .hero__cta--ghost {
    border: 1px solid rgba(2, 12, 89, 0.25);
    color: #020c59;
    background: rgba(255, 251, 245, 0.65);
  }
  .hero__cta--ghost:hover {
    text-decoration: none;
    color: #020c59;
    border-color: #695edb;
  }

  .floor {
    position: relative;
    z-index: 4;
    width: min(100% - 2.5rem, 760px);
    margin: 0.5rem auto 0;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
  }
  .offer {
    display: grid;
    gap: 0.28rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(2, 12, 89, 0.18);
    text-decoration: none;
    color: inherit;
  }
  .offer:hover { text-decoration: none; color: inherit; }
  .offer:hover strong { color: #695edb; }
  .offer__kicker {
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #5a6294;
  }
  .offer strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    max-width: 24ch;
    transition: color 200ms ease;
  }
  .offer--secondary strong {
    font-size: 1rem;
    font-weight: 500;
    max-width: 26ch;
  }
  .offer__meta {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 400;
    color: #2a3568;
  }

  @media (max-width: 860px) {
    .depth {
      min-height: 520px;
      height: min(78dvh, 640px);
    }
    .gem--hit {
      left: var(--mx);
      top: var(--my);
      width: 4rem;
    }
    .gem__label strong {
      font-size: 0.52rem;
      max-width: 12ch;
    }
    .hero {
      width: min(46vw, 150px);
      margin-left: calc(min(46vw, 150px) / -2);
      top: 12%;
    }
    .hero__name {
      font-size: clamp(2rem, 9vw, 2.6rem);
    }
    .hero__lead { display: none; }
    .floor {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      width: min(100% - 2rem, 720px);
    }
    .gem--dust { opacity: 0.2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gem--hit { transition: none; }
  }
</style>
