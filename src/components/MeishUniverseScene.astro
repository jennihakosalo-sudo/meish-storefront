---
import MeishStar from './MeishStar.astro';
import MeishGem from './MeishGem.astro';
import { orbitGroups } from '../data/meish-offers';

const placements: Record<string, string> = {
  review: 'review',
  improve: 'improve',
  build: 'build',
  tools: 'tools',
};
---

<section class="meish-universe" data-universe-scene aria-label="Meish Universe">
  <div class="meish-universe__sky" aria-hidden="true">
    <div class="meish-universe__vignette" />
    <div class="meish-universe__ring meish-universe__ring--outer" />
    <div class="meish-universe__ring meish-universe__ring--inner" />
  </div>

  <button type="button" id="motion-stop" class="motion-kill-switch" aria-pressed="false" title="Stop object motion">
    <span class="motion-kill-switch__lamp" aria-hidden="true" />
    <span class="motion-kill-switch__label">STOP OBJECT MOTION</span>
  </button>

  <div class="universe-compass">
    {orbitGroups.map((obj) => (
      <a
        href={obj.href}
        class={`universe-node universe-node--${placements[obj.id]}`}
        data-celestial={obj.id}
      >
        <MeishGem tint={obj.tint as 'navy' | 'lavender' | 'gold' | 'red'} />
        <span class="universe-node__label">{obj.shortLabel.toUpperCase()}</span>
        <span class="universe-node__tagline">{obj.tagline}</span>
      </a>
    ))}

    <div class="universe-compass__center">
      <div class="universe-compass__diamond" data-orbit-field>
        <MeishStar />
      </div>

      <div class="universe-identity">
        <p class="universe-identity__wordmark">MEISH</p>
        <p class="universe-identity__subline">Meish for Your Business</p>
        <p class="universe-identity__north">Human experience is our North Star.</p>
        <p class="universe-identity__support">
          We specialise in human experience — understanding it, reviewing it and making it better.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const scene = document.querySelector('[data-universe-scene]');
  const stopBtn = document.getElementById('motion-stop');
  const label = stopBtn?.querySelector('.motion-kill-switch__label');
  if (scene && stopBtn) {
    function setPaused(paused) {
      scene.classList.toggle('is-paused', paused);
      stopBtn.setAttribute('aria-pressed', String(paused));
      if (label) label.textContent = paused ? 'RESUME MOTION' : 'STOP OBJECT MOTION';
    }
    stopBtn.addEventListener('click', () => setPaused(!scene.classList.contains('is-paused')));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) setPaused(true);
  }
</script>
