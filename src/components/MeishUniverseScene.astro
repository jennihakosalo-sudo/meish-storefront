---
/**
 * Homepage hero. One board-center Intensive crystal (web 720).
 * Visual language from 7-facet boards. No F1–F7 / family labels.
 */
const diamondSrc = '/brand/meish-diamond-board-hero-720.png';

const doors = [
  { href: '/for-business', name: 'Meish for Your Business', hint: 'Offers that start with your situation' },
  { href: '/for-you', name: 'Meish for You', hint: 'Useful things for being human' },
  { href: '/tools', name: 'Tools', hint: 'Things you can use' },
  { href: '/gifts', name: 'Gifts for You', hint: 'Free. No signup.' },
];
---

<section class="hero" aria-label="Meish Universe">
  <div class="hero__field" aria-hidden="true">
    <div class="hero__wash hero__wash--indigo"></div>
    <div class="hero__wash hero__wash--mint"></div>
    <svg class="hero__orbits" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
      <ellipse cx="50" cy="44" rx="14" ry="10.5" />
      <ellipse cx="50" cy="44" rx="22" ry="16.5" />
      <ellipse cx="50" cy="44" rx="30" ry="22.5" />
      <line x1="50" y1="20" x2="50" y2="68" />
    </svg>
  </div>

  <div class="hero__core">
    <img
      class="hero__diamond"
      src={diamondSrc}
      alt=""
      width="218"
      height="360"
      fetchpriority="high"
      decoding="async"
    />
    <p class="hero__mark">Meish</p>
    <h1 class="hero__universe">Universe</h1>
    <p class="hero__north">Human experience is our North Star.</p>
    <p class="hero__lead">
      We notice what is happening in human experience — then make useful tools, maps and changes.
    </p>
    <p class="hero__langs">
      We work in English and Finnish.<br />
      Palvelemme myös suomeksi.
    </p>
  </div>

  <nav class="hero__doors" aria-label="Public doors">
    {doors.map((d) => (
      <a class="hero__door" href={d.href}>
        <span class="hero__signal" aria-hidden="true"></span>
        <strong>{d.name}</strong>
        <span>{d.hint}</span>
      </a>
    ))}
  </nav>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: #081020;
    color: #eaf6ff;
    padding: clamp(5.5rem, 10vw, 7rem) 1.25rem 3.25rem;
    overflow: hidden;
  }

  .hero__field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero__wash {
    position: absolute;
    border-radius: 50%;
    filter: blur(88px);
    opacity: 0.28;
  }
  .hero__wash--indigo {
    width: min(48vw, 400px);
    height: min(48vw, 400px);
    left: 50%;
    top: 8%;
    transform: translateX(-58%);
    background: radial-gradient(circle, rgba(106, 90, 205, 0.35) 0%, transparent 72%);
  }
  .hero__wash--mint {
    width: min(32vw, 260px);
    height: min(32vw, 260px);
    left: 50%;
    top: 24%;
    transform: translateX(-6%);
    background: radial-gradient(circle, rgba(0, 195, 214, 0.12) 0%, transparent 74%);
  }

  .hero__orbits {
    position: absolute;
    left: 50%;
    top: 7%;
    width: min(48vw, 380px);
    height: min(48vw, 380px);
    margin-left: calc(min(48vw, 380px) / -2);
    fill: none;
    stroke: rgba(234, 246, 255, 0.07);
    stroke-width: 0.11;
  }

  .hero__core {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    margin: 0 auto;
    text-align: center;
  }

  .hero__diamond {
    display: block;
    width: min(24vw, 136px);
    height: auto;
    margin: 0 auto 1.15rem;
    background: transparent;
    filter: drop-shadow(0 0 10px rgba(106, 90, 205, 0.16));
  }

  .hero__mark {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.1rem, 8vw, 5rem);
    font-weight: 700;
    font-style: normal;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: #eaf6ff;
  }

  .hero__universe {
    margin: 0.45rem 0 0;
    font-family: var(--font-body);
    font-size: clamp(0.78rem, 1.4vw, 0.88rem);
    font-weight: 500;
    letter-spacing: 0.46em;
    text-transform: uppercase;
    color: rgba(234, 246, 255, 0.5);
  }

  .hero__north {
    margin: 1.45rem auto 0;
    font-family: var(--font-body);
    font-style: normal;
    font-size: clamp(1.2rem, 2.3vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
    color: #eaf6ff;
    max-width: 22ch;
  }

  .hero__lead {
    margin: 0.9rem auto 0;
    font-family: var(--font-body);
    font-size: clamp(1.08rem, 1.9vw, 1.22rem);
    line-height: 1.45;
    color: rgba(234, 246, 255, 0.82);
    max-width: 36ch;
  }

  .hero__langs {
    margin: 1rem auto 0;
    font-size: 1.02rem;
    line-height: 1.5;
    color: rgba(234, 246, 255, 0.58);
  }

  .hero__doors {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.4rem 1.6rem;
    max-width: 58rem;
    margin: 3rem auto 0;
    padding-top: 1.85rem;
    border-top: 1px solid rgba(234, 246, 255, 0.08);
  }

  .hero__door {
    display: grid;
    justify-items: start;
    gap: 0.35rem;
    text-decoration: none;
    color: inherit;
  }
  .hero__door:hover {
    text-decoration: none;
    color: inherit;
  }
  .hero__door:hover strong {
    color: #00c3d6;
  }

  .hero__signal {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #eaf6ff 0%, #6a5acd 70%);
    box-shadow: 0 0 6px rgba(0, 195, 214, 0.22);
    margin-bottom: 0.2rem;
  }

  .hero__door strong {
    font-family: var(--font-display);
    font-style: normal;
    font-size: clamp(1.08rem, 1.7vw, 1.28rem);
    font-weight: 600;
    line-height: 1.2;
    color: #eaf6ff;
  }

  .hero__door span {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.35;
    color: rgba(234, 246, 255, 0.6);
    max-width: 20ch;
  }

  @media (max-width: 800px) {
    .hero__doors {
      grid-template-columns: 1fr 1fr;
    }
    .hero__diamond {
      width: min(36vw, 120px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__wash {
      filter: blur(40px);
      opacity: 0.2;
    }
  }
</style>
