---
const lines = [
  'Human experience is our North Star.',
  'Useful can also be beautiful.',
  'We notice friction. Then we make things better.',
  '.work? Why? Because this works.',
];
---

<div class="split-flap" data-flap aria-label="Meish philosophy">
  <div class="split-flap__cabinet">
    <div class="split-flap__header">
      <span class="split-flap__plate">Meish Philosophy</span>
      <span class="split-flap__indicator" data-flap-indicator aria-hidden="true">●</span>
    </div>

    <div class="split-flap__display" aria-live="polite">
      {lines.map((line, i) => (
        <div class="split-flap__row" data-flap-line data-index={i} hidden={i !== 0}>
          <span class="split-flap__char-row">{line}</span>
        </div>
      ))}
    </div>

    <div class="split-flap__controls">
      <button type="button" class="split-flap__key" data-flap-prev>Previous</button>
      <button type="button" class="split-flap__key split-flap__key--pause" data-flap-pause aria-pressed="false">Pause</button>
      <button type="button" class="split-flap__key" data-flap-next>Next</button>
    </div>
  </div>
</div>

<script define:vars={{ lines }}>
  const flap = document.querySelector('[data-flap]');
  if (!flap) return;

  const lineEls = flap.querySelectorAll('[data-flap-line]');
  const pauseBtn = flap.querySelector('[data-flap-pause]');
  let current = 0;
  let timer = null;
  let paused = false;

  function show(index) {
    lineEls.forEach((el, i) => {
      el.hidden = i !== index;
      if (i === index) {
        el.classList.remove('is-flipping');
        void el.offsetWidth;
        el.classList.add('is-flipping');
      }
    });
    current = index;
  }

  function next() { show((current + 1) % lineEls.length); }
  function prev() { show((current - 1 + lineEls.length) % lineEls.length); }

  function startAuto() {
    if (timer) clearInterval(timer);
    if (paused) return;
    timer = setInterval(next, 5500);
  }

  flap.querySelector('[data-flap-next]')?.addEventListener('click', () => { next(); startAuto(); });
  flap.querySelector('[data-flap-prev]')?.addEventListener('click', () => { prev(); startAuto(); });

  pauseBtn?.addEventListener('click', () => {
    paused = !paused;
    pauseBtn.setAttribute('aria-pressed', String(paused));
    pauseBtn.textContent = paused ? 'Resume' : 'Pause';
    if (paused) {
      if (timer) clearInterval(timer);
      timer = null;
    } else {
      startAuto();
    }
  });

  window.addEventListener('meish:motion-pause', (e) => {
    if (e.detail?.paused) {
      paused = true;
      pauseBtn?.setAttribute('aria-pressed', 'true');
      if (pauseBtn) pauseBtn.textContent = 'Resume';
      if (timer) clearInterval(timer);
      timer = null;
    }
  });

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    startAuto();
  }
</script>

<style>
  .split-flap {
    width: 100%;
  }

  .split-flap__cabinet {
    background: linear-gradient(180deg, #1a1a1a 0%, #0d0d0d 100%);
    border: 3px solid #2a2a2a;
    border-radius: 4px;
    padding: 0.85rem 1rem 1rem;
    box-shadow:
      0 16px 40px rgba(2, 12, 89, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      inset 0 -2px 0 rgba(0, 0, 0, 0.5);
  }

  .split-flap__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(251, 215, 159, 0.2);
  }

  .split-flap__plate {
    font-size: 0.55rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(251, 215, 159, 0.65);
  }

  .split-flap__indicator {
    color: var(--color-red);
    font-size: 0.5rem;
    animation: flap-indicator 2s ease-in-out infinite;
  }

  @keyframes flap-indicator {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .split-flap__display {
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    background: #0a0a0a;
    border: 1px solid #222;
    padding: 0.85rem 1rem;
    margin-bottom: 0.75rem;
    position: relative;
    overflow: hidden;
  }

  .split-flap__display::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255, 255, 255, 0.015) 2px,
      rgba(255, 255, 255, 0.015) 4px
    );
    pointer-events: none;
  }

  .split-flap__row {
    width: 100%;
  }

  .split-flap__row[hidden] { display: none; }

  .split-flap__char-row {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    font-weight: var(--weight-semibold);
    color: #f5f0e8;
    letter-spacing: 0.02em;
    line-height: 1.35;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.5);
  }

  .split-flap__row.is-flipping .split-flap__char-row {
    animation: flap-drop 0.55s var(--ease);
  }

  @keyframes flap-drop {
    0% { transform: translateY(-100%) rotateX(40deg); opacity: 0; }
    60% { transform: translateY(4px) rotateX(-8deg); opacity: 1; }
    100% { transform: translateY(0) rotateX(0); opacity: 1; }
  }

  .split-flap__controls {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
  }

  .split-flap__key {
    flex: 1;
    max-width: 7rem;
    padding: 0.55rem 0.5rem;
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ccc;
    background: linear-gradient(180deg, #3a3a3a 0%, #222 100%);
    border: 1px solid #111;
    border-radius: 2px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 2px 4px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease);
  }

  .split-flap__key:hover {
    background: linear-gradient(180deg, #444 0%, #2a2a2a 100%);
    color: var(--color-gold);
  }

  .split-flap__key--pause[aria-pressed='true'] {
    color: var(--color-gold);
    border-color: rgba(251, 215, 159, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .split-flap__row.is-flipping .split-flap__char-row { animation: none; }
    .split-flap__indicator { animation: none; }
  }
</style>
