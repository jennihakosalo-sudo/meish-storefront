---
/**
 * One product, five facts, nothing else.
 *
 * Deliberately not a boxed card: a thin rule and a coloured node group the
 * facts without drawing a rectangle around them. Six rectangles in a row is
 * the look the brief rules out, and it is also the look that makes a €0
 * conversation and a €950 engagement appear to be the same kind of thing.
 */
/* Typed against the fields the card actually renders rather than against one
   product module, so both the homepage set in site-content and the wider
   catalogue in meish-products can be passed without conversion. */
interface CardProduct {
  slug: string;
  category: string;
  name: string;
  promise: string;
  price: string;
  accent: string;
  cta: { label: string; href: string };
}

interface Props {
  product: CardProduct;
  /** Renders the price larger and the name at heading scale. */
  featured?: boolean;
  /**
   * The homepage names the products but does not price them: a price asked for
   * before the work is understood invites a comparison rather than a question.
   * Prices live on the pages that explain what is being bought.
   */
  showPrice?: boolean;
}

const { product, featured = false, showPrice = true } = Astro.props as Props;

/* Keep the final word and the arrow together. Without this the longest label
   wrapped and left the arrow sitting alone on a second line. */
const words = product.cta.label.split(' ');
const ctaTail = words.pop() ?? '';
const ctaHead = words.join(' ');
---

<article
  class:list={['product', featured && 'product--featured', !showPrice && 'product--unpriced']}
  style={`--accent-node: ${product.accent}`}
  id={product.slug}
>
  <p class="product__category">
    <span class="product__node" aria-hidden="true"></span>
    {product.category}
  </p>
  <h3 class="product__name">{product.name}</h3>
  <p class="product__promise">{product.promise}</p>
  {showPrice && <p class="product__price">{product.price}</p>}
  <p class="product__action">
    {/* Kept on one line: broken across lines, the template collapses the space
        between the head and the tail and the label renders as one word. */}
    <a href={product.cta.href}>{ctaHead} <span class="product__tail">{ctaTail} →</span></a>
  </p>
</article>

<style>
  .product {
    /* Fixed rows so the promise absorbs the slack and the prices line up with
       each other across a row of cards. Comparing three prices should not
       require the eye to hunt for them at three different heights. */
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    /* The rule sits above the content and is the only frame there is. */
    border-top: 1px solid var(--color-line-strong);
    padding-top: 1.15rem;
  }

  .product__category {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    max-width: none;
  }

  .product__node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-node);
    flex: none;
  }

  .product__name {
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.24;
    letter-spacing: 0;
  }

  .product__promise {
    margin: 0.6rem 0 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.58;
    color: var(--color-ink-soft);
    max-width: 38ch;
    text-wrap: pretty;
  }

  /* One row fewer when there is no price, so the promise still absorbs the
     slack and the actions still line up across a row of cards. */
  .product--unpriced {
    grid-template-rows: auto auto 1fr auto;
  }

  .product__price {
    margin: 0.75rem 0 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    color: #13254a;
    font-variant-numeric: tabular-nums;
  }

  /* Pushed to the bottom so actions line up across a row of unequal cards. */
  .product__action {
    margin: 0.85rem 0 0;
    /* Padding rather than min-height on the link: the link has to stay inline
       so a two-line label wraps as text instead of as two flex items. */
    padding-block: 0.6rem;
    font-family: var(--font-ui);
    font-size: var(--text-base);
    line-height: 1.5;
  }
  .product__action a {
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.22em;
  }
  .product__action a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .product__tail {
    white-space: nowrap;
  }

  /* The featured product spans the full row, so its copy needs a second column
     to sit in — otherwise the price and action strand themselves on the left
     with two thirds of the row empty. */
  .product--featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
    gap: 0.4rem 3rem;
    align-items: start;
  }
  .product--featured .product__category,
  .product--featured .product__name,
  .product--featured .product__promise {
    grid-column: 1;
  }
  .product--featured .product__price {
    grid-column: 2;
    grid-row: 2;
    margin-top: 0.75rem;
  }
  .product--featured .product__action {
    grid-column: 2;
    grid-row: 3;
    margin-top: 0.15rem;
  }
  /* Without a price above it, the action takes the row the price would have
     had — otherwise it sits a row down from nothing. */
  .product--featured.product--unpriced .product__action {
    grid-row: 2;
    margin-top: 0.75rem;
  }

  .product--featured .product__name {
    font-size: clamp(1.5rem, 2.2vw, 1.875rem);
  }
  .product--featured .product__promise {
    font-size: 1.0625rem;
    max-width: 44ch;
  }
  .product--featured .product__price {
    font-size: 0.9375rem;
    font-weight: 400;
  }

  @media (max-width: 48rem) {
    /* One column on a phone: the price belongs under the promise, not beside
       it in a 15rem gutter that no longer exists. */
    .product--featured {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .product--featured .product__price,
    .product--featured .product__action {
      grid-column: 1;
      grid-row: auto;
    }
    .product--featured .product__price {
      margin-top: 1rem;
    }
    .product--featured .product__action {
      margin-top: 0.85rem;
    }
  }
</style>
