---
import { getLadderOffers, getFitCheckOffer } from '../data/meish-offers';
import GammaTestPhaseExplainer from './GammaTestPhaseExplainer.astro';

const offers = getLadderOffers();
const fitCheck = getFitCheckOffer();
---

<section id="products" class="product-catalog section">
  <div class="container">
    <ol class="product-ladder">
      {
        offers.map((product) => {
          const isPrimary = product.id === 'possibility-map';
          return (
            <li
              id={product.id}
              class:list={[
                'product-ladder__item',
                `product-ladder__item--p${product.priority}`,
                isPrimary && 'product-ladder__item--primary',
              ]}
            >
              <p class="product-card__category">{product.category}</p>
              <h3 class="product-ladder__name">{product.name}</h3>
              <p class="product-card__summary">{product.summary}</p>

              <dl class="product-meta">
                <div>
                  <dt>Who it is for</dt>
                  <dd>{product.whoFor}</dd>
                </div>
                <div>
                  <dt>What you leave with</dt>
                  <dd>
                    <ul class="product-card__includes">
                      {product.includes.slice(0, 5).map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              </dl>

              <p class="product-card__price">
                {product.price}
                {product.gammaTestPhase ? (
                  <>
                    {' '}
                    <span aria-hidden="true">·</span>{' '}
                    <button type="button" class="gamma-phase-link" data-gamma-open>
                      Gamma Test Phase
                    </button>
                  </>
                ) : (
                  product.duration && (
                    <span class="product-card__duration"> · {product.duration}</span>
                  )
                )}
              </p>

              {product.priceNote && <p class="product-card__note">{product.priceNote}</p>}

              {product.id === 'possibility-map' && product.duration && (
                <p class="product-card__note product-card__note--soft">{product.duration}</p>
              )}

              {product.applications && (
                <p class="product-card__apps">
                  <span class="product-card__apps-label">Examples:</span>{' '}
                  {product.applications.join(' · ')}
                </p>
              )}

              <a
                href={product.ctaHref}
                class:list={['button', isPrimary ? 'button--primary' : 'button--ghost']}
              >
                {product.cta}
              </a>
            </li>
          );
        })
      }
    </ol>

    <aside class="product-ladder__fallback" aria-label="Not sure which offer">
      <p>
        <strong>Not sure which one?</strong> Start with the 20-minute Fit Check — free.
      </p>
      {
        fitCheck && (
          <a href={fitCheck.ctaHref} class="button button--ghost">
            {fitCheck.cta}
          </a>
        )
      }
    </aside>
  </div>

  <GammaTestPhaseExplainer />
</section>

<style>
  .product-catalog {
    background: #fffbf5;
    border-top: 1px solid rgba(2, 12, 89, 0.1);
    padding-top: var(--space-lg);
  }

  .product-ladder {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .product-ladder__item {
    position: relative;
    padding: var(--space-xl);
    background: rgba(255, 253, 249, 0.9);
    border: 1px solid rgba(251, 215, 159, 0.35);
    box-shadow: 0 12px 36px rgba(2, 12, 89, 0.05);
  }

  .product-ladder__item--primary {
    border-color: rgba(2, 12, 89, 0.22);
    background: linear-gradient(
      165deg,
      rgba(251, 215, 159, 0.22) 0%,
      rgba(255, 253, 249, 0.97) 55%
    );
  }

  .product-ladder__item--p1 {
    border-color: rgba(2, 12, 89, 0.18);
  }

  .product-card__category {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-lavender);
    margin-bottom: var(--space-xs);
    max-width: none;
  }

  .product-ladder__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .product-card__summary {
    font-size: var(--text-sm);
    color: var(--text-soft);
    margin-bottom: var(--space-md);
    max-width: 48ch;
  }

  .product-meta {
    margin: 0 0 var(--space-md);
  }

  .product-meta > div {
    margin-bottom: var(--space-sm);
  }

  .product-meta dt {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .product-meta dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .product-card__price {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-navy);
    margin-bottom: var(--space-xs);
    max-width: none;
  }

  .product-card__note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-md);
    max-width: none;
  }

  .product-card__note--soft {
    margin-top: -0.5rem;
  }

  .product-card__includes {
    margin: 0.25rem 0 0;
    padding-left: 1.15rem;
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .product-card__includes li {
    margin-bottom: 0.25rem;
  }

  .product-card__apps {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0 0 var(--space-md);
    max-width: none;
  }

  .product-card__apps-label {
    font-weight: var(--weight-medium);
    color: var(--text-soft);
  }

  .product-ladder__fallback {
    margin-top: var(--space-3xl);
    padding: var(--space-xl);
    text-align: center;
    background: rgba(105, 94, 219, 0.07);
    border: 1px solid rgba(105, 94, 219, 0.18);
    border-radius: 12px;
  }

  .product-ladder__fallback p {
    margin: 0 0 var(--space-md);
    max-width: none;
  }

  @media (min-width: 900px) {
    .product-ladder__item--entry,
    .product-ladder__item--p2 {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: var(--space-xl);
      align-items: start;
    }

    .product-ladder__item--entry .button,
    .product-ladder__item--p2 .button {
      grid-column: 2;
      grid-row: 1 / span 6;
      align-self: center;
      white-space: nowrap;
    }
  }
</style>
