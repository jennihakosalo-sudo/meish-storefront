---
/**
 * One product at full length, for the pages a visitor reaches after deciding
 * they are interested.
 *
 * The card in a grid answers "what is this and what does it cost". This
 * answers the three questions someone asks before writing an email: when
 * would I get in touch, what would actually happen, and what do I end up
 * with. The sentences come from the site's own situation copy, so a reader
 * who saw the homepage meets the same words rather than a second version of
 * the same claim.
 *
 * Laid out as a register entry, not a card: a rule above, the name and the
 * situation in one column, the price and the action in a narrow second column
 * where the eye already goes looking for them.
 */
import type { ProductDetail } from '../data/site-content';

interface Props {
  product: ProductDetail;
}

const { product } = Astro.props as Props;
---

<article class="detail" style={`--accent-node: ${product.accent}`} id={product.slug}>
  <div class="detail__main">
    <p class="detail__category">
      <span class="detail__node" aria-hidden="true"></span>
      {product.category}
    </p>
    <h3 class="detail__name">{product.name}</h3>
    <p class="detail__promise">{product.promise}</p>
    {product.what.map((line) => <p class="detail__line">{line}</p>)}
  </div>

  <div class="detail__aside">
    {product.price && <p class="detail__price">{product.price}</p>}
    <p class="detail__action">
      <a href={product.cta.href}>Email Meish about this</a>
    </p>
  </div>
</article>

<style>
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 14rem);
    gap: 0.5rem 3rem;
    align-items: start;
    border-top: 1px solid var(--color-line-strong);
    padding-top: 1.25rem;
  }

  .detail__category {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    max-width: none;
  }
  .detail__node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-node);
    flex: none;
  }

  .detail__name {
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: 0;
  }

  /* The promise is the product in one line and sits closer to the name than
     to the sentences below it, so it reads as part of the title rather than
     as the first of four paragraphs. */
  .detail__promise {
    margin: 0.55rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-navy);
    max-width: 44ch;
    text-wrap: pretty;
  }

  .detail__line {
    margin: 0.9rem 0 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.62;
    color: var(--color-ink-soft);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .detail__line:first-of-type {
    margin-top: 1.25rem;
  }

  .detail__aside {
    /* Same top edge as the name, not as the category label above it: the price
       lines up with the thing it is the price of. */
    padding-top: 2.1rem;
  }
  .detail__price {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    color: #13254a;
    font-variant-numeric: tabular-nums;
  }
  .detail__action {
    margin: 0.4rem 0 0;
    font-family: var(--font-ui);
    font-size: 1rem;
    line-height: 1.5;
  }
  /* The padding is on the link, not the paragraph around it: a one-line label
     gives a 20px tap target otherwise, which is too small to hit on a phone. */
  .detail__action a {
    display: inline-block;
    padding-block: 0.6rem;
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.22em;
  }
  .detail__action a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  @media (max-width: 48rem) {
    .detail {
      grid-template-columns: 1fr;
      gap: 0;
    }
    /* Stacked, the aside is no longer beside anything, so the alignment
       padding would just be a gap. */
    .detail__aside {
      padding-top: 1.25rem;
    }
  }
</style>
