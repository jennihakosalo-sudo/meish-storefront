---
// Four doors orbit the central diamond — cardinal positions, museum placards on hover.
const doors = [
  {
    id: 'review',
    label: 'Reviewing Human Experience',
    short: 'ExR',
    angle: 0,
    href: '#review',
    placard: 'Experience Review method — how we read and improve human experience in real places.',
  },
  {
    id: 'business',
    label: 'Meish for Your Business',
    short: 'Business',
    angle: 90,
    href: '#business',
    placard: 'Possibility Map, 20-minute Fit Check, and practical next steps for founders and teams.',
  },
  {
    id: 'gifts',
    label: 'Meish Gifts',
    short: 'Gifts',
    angle: 180,
    href: '#gifts',
    placard: 'Thoughtful gifts and rituals — including RAMI, a name-giving experience.',
  },
  {
    id: 'tools',
    label: 'Meish Tools',
    short: 'Tools',
    angle: 270,
    href: '#tools',
    placard: 'Custom tools when the right ones do not exist yet. Elements, Friction, Fiction, BA — coming soon.',
  },
];
---

<section class="universe-hero" aria-label="Meish Universe">
  <div class="universe-hero__field">
    <div class="universe-hero__orbit" data-orbit>
      {doors.map((door) => (
        <a
          href={door.href}
          class="universe-hero__door"
          style={`--door-angle: ${door.angle}deg`}
          data-door={door.id}
        >
          <span class="universe-hero__door-dot" aria-hidden="true" />
          <span class="universe-hero__door-label">{door.short}</span>
          <span class="universe-hero__placard" role="tooltip">
            <strong>{door.label}</strong>
            <span>{door.placard}</span>
          </span>
        </a>
      ))}
    </div>

    <div class="universe-hero__diamond-wrap">
      <img
        src="/brand/meish-diamond-emblem.png"
        alt=""
        class="universe-hero__diamond"
        width="280"
        height="280"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <ul class="universe-hero__static-list" aria-label="Four doors">
    {doors.map((door) => (
      <li><a href={door.href}>{door.label}</a></li>
    ))}
  </ul>
</section>

<script>
  const orbit = document.querySelector('[data-orbit]');
  const stopBtn = document.getElementById('motion-stop');
  if (orbit && stopBtn) {
    stopBtn.addEventListener('click', () => {
      const paused = orbit.classList.toggle('is-paused');
      stopBtn.setAttribute('aria-pressed', String(paused));
      stopBtn.textContent = paused ? 'RESUME MOTION' : 'STOP OBJECT MOTION';
    });
  }
</script>

<style>
  .universe-hero {
    position: relative;
    margin-block: var(--space-xl) var(--space-2xl);
  }

  .universe-hero__field {
    position: relative;
    width: min(100%, 520px);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .universe-hero__diamond-wrap {
    position: absolute;
    inset: 50%;
    transform: translate(-50%, -50%);
    width: 55%;
    z-index: 2;
    pointer-events: none;
  }

  .universe-hero__diamond {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 40px rgba(105, 94, 219, 0.35));
    animation: diamond-float 8s ease-in-out infinite;
  }

  @keyframes diamond-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .universe-hero__orbit {
    position: absolute;
    inset: 0;
    animation: orbit-spin 120s linear infinite;
  }

  .universe-hero__orbit.is-paused {
    animation-play-state: paused;
  }

  .universe-hero__orbit.is-paused .universe-hero__door {
    animation-play-state: paused;
  }

  @keyframes orbit-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .universe-hero__door {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 3.5rem;
    height: 3.5rem;
    margin: -1.75rem;
    transform: rotate(var(--door-angle)) translateY(-42%) rotate(calc(-1 * var(--door-angle)));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    text-decoration: none;
    color: var(--text);
    animation: counter-spin 120s linear infinite;
    transition: transform var(--dur) var(--ease);
    z-index: 3;
  }

  @keyframes counter-spin {
    from { transform: rotate(var(--door-angle)) translateY(-42%) rotate(calc(-1 * var(--door-angle))); }
    to { transform: rotate(calc(var(--door-angle) + 360deg)) translateY(-42%) rotate(calc(-1 * var(--door-angle) - 360deg)); }
  }

  .universe-hero__door:hover,
  .universe-hero__door:focus-visible {
    transform: rotate(var(--door-angle)) translateY(-42%) rotate(calc(-1 * var(--door-angle))) scale(1.15);
    text-decoration: none;
    color: var(--accent);
  }

  .universe-hero__door-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--color-lavender);
    box-shadow: 0 0 12px rgba(105, 94, 219, 0.5);
  }

  .universe-hero__door-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .universe-hero__placard {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%) scale(0.95);
    opacity: 0;
    pointer-events: none;
    width: max-content;
    max-width: 220px;
    padding: var(--space-sm) var(--space-md);
    background: var(--surface);
    border: var(--border-hair);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--text-soft);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
    z-index: 10;
  }

  .universe-hero__placard strong {
    display: block;
    color: var(--text);
    font-weight: var(--weight-semibold);
    margin-bottom: 0.25em;
  }

  .universe-hero__door:hover .universe-hero__placard,
  .universe-hero__door:focus-visible .universe-hero__placard {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }

  .universe-hero__static-list {
    display: none;
    list-style: none;
    padding: 0;
    margin-top: var(--space-lg);
    text-align: center;
    gap: var(--space-sm);
  }

  .universe-hero__static-list a {
    color: var(--text-soft);
    font-size: var(--text-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .universe-hero__orbit,
    .universe-hero__door,
    .universe-hero__diamond {
      animation: none !important;
    }

    .universe-hero__field { display: none; }

    .universe-hero__static-list {
      display: grid;
    }
  }
</style>
