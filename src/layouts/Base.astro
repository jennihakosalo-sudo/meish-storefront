---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  universeHome?: boolean;
}

const {
  title = 'Meish — human experience is our North Star',
  description = 'Meish specialises in human experience — for business, spaces, gifts and custom tools. Possibility Map from 590 € + VAT.',
  universeHome = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Roboto = body. ATHENA Condensed pending in public/fonts/. Bodoni Moda is the temporary display stand-in. -->
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,600;0,6..96,700;1,6..96,400&family=Roboto:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Meish" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <meta name="theme-color" content="#FFFBF5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class:list={universeHome && 'is-universe-home'}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header universeHome={universeHome} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/cart';
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: var(--space-md);
        top: -3rem;
        z-index: var(--z-overlay);
        background: var(--text);
        color: var(--bg);
        padding: var(--space-xs) var(--space-md);
        border-radius: var(--radius-sm);
        transition: top var(--dur) var(--ease);
      }
      .skip-link:focus { top: var(--space-md); color: var(--bg); }

      body.is-universe-home {
        background: var(--color-cream);
      }
    </style>
  </body>
</html>
