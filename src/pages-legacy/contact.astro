---
/**
 * Contact.
 *
 * One address and one action. An email reaches the same person a form would,
 * and is easier to write in your own words.
 *
 * No personal name, direct phone number or business ID appears on this page.
 * The public address is the shared one in lib/meish-mailto.
 */
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, mailTo } from '../data/site-content';

const writeMail = mailTo('Meish');

const helpful = [
  'Your name.',
  'What you are thinking about — roughly is fine.',
  'Whether this is for you, your business, or a place.',
  'Anything already decided, so we do not re-open it.',
];
---

<Base
  title="Contact Meish"
  description="Write to Meish. You can come with the situation — you do not need the answer. English and Finnish."
>
  <section class="head">
    <div class="container">
      <p class="head__eyebrow">Contact</p>
      <h1>You can come with the situation.</h1>
      <p class="head__lead">
        You do not have to come with the answer. An idea, an opportunity, a question, or something
        you cannot quite name yet is enough to start.
      </p>
      <p class="head__langs">
        We work in English and Finnish. <span lang="fi">Palvelemme myös suomeksi.</span>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="write-title">
    <div class="container">
      <h2 id="write-title">Write to Meish</h2>
      <p class="band__address">
        <a href={writeMail}>{CONTACT_EMAIL}</a>
      </p>
      <p class="band__intro">
        You’ll talk directly with someone who does the work. Replies usually come within a working
        day.
      </p>
      <p class="band__action">
        <a class="button button--primary" href={writeMail}>Open a message</a>
        <a class="button button--ghost" href="/fit-check">Book a Fit Check — €0</a>
      </p>
    </div>
  </section>

  <section class="band band--soft" aria-labelledby="helpful-title">
    <div class="container">
      <h2 id="helpful-title">It helps to include</h2>
      <ul class="helpful">
        {helpful.map((h) => <li>{h}</li>)}
      </ul>
      <p class="band__intro">
        None of it is required. A single sentence gets a reply too.
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="privacy-title">
    <div class="container">
      <h2 id="privacy-title">What happens to what you send</h2>
      <p class="band__intro">
        It is read by a person and used to answer you. It is not added to a mailing list, not sold,
        and not fed to anyone else. The details are in
        <a href="/privacy">privacy and boundaries</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.75rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.25rem);
    background: var(--color-ivory);
  }
  .head__eyebrow {
    margin: 0 0 0.8rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .head h1 {
    margin: 0;
    font-size: var(--text-page);
    font-weight: 400;
    max-width: 20ch;
  }
  .head__lead {
    margin: 1.15rem 0 0;
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    max-width: 48ch;
    color: var(--color-ink-soft);
  }
  .head__langs {
    margin: 1rem 0 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink-muted);
  }

  .band {
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
  }
  .band--soft {
    background: var(--color-cream);
  }
  .band h2 {
    font-weight: 400;
  }
  .band__intro {
    margin: 1.4rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.64;
    max-width: 52ch;
    color: var(--color-ink-soft);
  }
  .band__action {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
    max-width: none;
  }

  /* The address is the content of this page, so it is set at display size
     rather than buried in a paragraph. */
  .band__address {
    margin: 1.2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    max-width: none;
  }
  .band__address a {
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.22em;
    /* Long addresses must be able to break rather than push the page wide. */
    overflow-wrap: anywhere;
  }
  .band__address a:hover {
    color: var(--accent);
  }

  .helpful {
    list-style: none;
    margin: 1.35rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-navy);
  }
  .helpful li {
    position: relative;
    padding-left: 1.35rem;
  }
  .helpful li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.6rem;
    height: 1px;
    background: var(--color-line-strong);
  }
</style>
