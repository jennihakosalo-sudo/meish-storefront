---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Meish">
  <section class="section container" style="text-align:center; padding-block: var(--space-4xl);">
    <p class="eyebrow">Error 404</p>
    <h1 style="font-size: var(--text-3xl); font-weight: 900;">This page is not here.</h1>
    <p class="lead" style="margin-inline:auto;">You can go home, or start with a conversation.</p>
    <p style="margin-top: var(--space-lg);">
      <a class="button button--primary" href="/">Back home</a>
      <a class="button button--ghost" href="/contact">Contact</a>
    </p>
  </section>
</Base>
