---
/**
 * About Meish.
 *
 * Uses the secondary line — "Built for human experience." — rather than the
 * primary one, which belongs to the homepage. This page explains the working
 * principle plainly and then gets out of the way.
 */
import Base from '../layouts/Base.astro';
import LightHero from '../components/LightHero.astro';
import { CONTACT_EMAIL, mailTo, brand, contactAction, pageHeroes } from '../data/site-content';

const beliefs = [
  [
    'Recognition before creation',
    'We do not assume something is wrong. We look at what is actually there first, and sometimes the answer is that it needs nothing.',
  ],
  [
    'The person stays the decision-maker',
    'We make possibilities visible and say what we would choose. Choosing is still yours, and so is the understanding of why.',
  ],
  [
    'Smaller than the problem',
    'A tool, a change or a project should be no larger or more technical than the thing genuinely requires.',
  ],
  [
    'Removing counts as building',
    'Fewer steps, fewer decisions, fewer things to maintain. Better does not automatically mean more.',
  ],
  [
    'If it frees time, the time stays free',
    'Work that gives back four hours a week has only worked if those four hours do not immediately fill up again.',
  ],
];

/* Matches the header. /for-you and /treasure are not offered publicly in this
   release; their source files remain, but nothing routes a visitor to them. */
const routes = [
  ['/for-business', 'Business', 'Direction, first tests, human experience, useful AI.'],
  ['/for-your-space', 'Space', 'What a place is doing to the people in it.'],
  ['/tools', 'Tools', 'Small instruments for one situation each.'],
];
---

<Base
  title="About Meish — built for human experience"
  description="Meish observes what is actually happening for people, makes possibilities visible and turns the right ones into something useful. English and Finnish."
>
  <LightHero {...pageHeroes.about} action={null} />

  <section class="band" aria-labelledby="believe-title">
    <div class="container believe">
      <div>
        <h2 id="believe-title">How we work, and why</h2>
        <dl class="beliefs">
          {
            beliefs.map(([name, note]) => (
              <div class="beliefs__row">
                <dt>{name}</dt>
                <dd>{note}</dd>
              </div>
            ))
          }
        </dl>
        <p class="believe__langs">We work in English and Finnish.</p>
      </div>

      {/* The one large diamond on this page, and the only one outside the
          header. It sits beside how we work rather than beside the opening
          statement, because the opening is now a photograph. Copy first in the
          source so it also reads correctly stacked. */}
      <div class="believe__gem">
        <img src={brand.diamond} alt="" width="360" height="540" decoding="async" />
      </div>
    </div>
  </section>

  <section class="band band--soft" aria-labelledby="where-title">
    <div class="container">
      <h2 id="where-title">Where to go from here</h2>
      <ul class="routes">
        {
          routes.map(([href, name, note]) => (
            <li>
              <a href={href}>{name}</a>
              <span>{note}</span>
            </li>
          ))
        }
      </ul>
      <p class="band__intro">
        How we handle information is written down in
        <a href="/privacy">privacy and boundaries</a>.
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="entities-title">
    <div class="container entities">
      <p class="entities__mark">Coming / in development</p>
      <h2 id="entities-title">Meish Entities</h2>
      <p>Well-trained AI assistants designed around real human use.</p>
      <p>Planning that starts from the person.</p>
      <p>Strong practical skill.</p>
      <p>Everyday usefulness.</p>
      <p>For an individual, a family, work, or a place.</p>
      <p class="entities__quiet">Not available yet.</p>
    </div>
  </section>

  <section class="band band--ink on-dark" aria-labelledby="talk-title">
    <div class="container">
      <h2 id="talk-title">Talk to a person.</h2>
      <p class="band__intro">
        Meish is a small Finnish practice. You’ll talk directly with someone who does the work.
      </p>
      <p class="band__address">
        <a href={mailTo('Meish')}>{CONTACT_EMAIL}</a>
      </p>
      <p class="band__action">
        <a class="button button--primary" href={contactAction.href}>{contactAction.label}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* Copy left, diamond right, nothing between them. No frame and no backdrop:
     the asset is transparent and carries its own light. */
  .believe {
    display: grid;
    /* The list takes what it needs; the diamond takes what is left. The list
       is a two-column definition list in its own right, so capping it would
       squeeze two columns into one narrow one. */
    grid-template-columns: minmax(0, 1fr) minmax(7rem, 12rem);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .believe__gem img {
    display: block;
    width: 100%;
    height: auto;
    background: transparent;
  }
  .believe__langs {
    margin: 1.75rem 0 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink-muted);
  }

  .band {
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  .band--soft {
    background: var(--color-cream);
  }
  .band--ink {
    background: var(--meish-navy);
    color: var(--meish-ivory);
  }
  .band--ink :global(h2) {
    color: var(--meish-ivory);
  }
  .band h2 {
    font-weight: 400;
  }
  .band__intro {
    margin: 1.6rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.64;
    max-width: 52ch;
    color: var(--color-ink-soft);
  }
  .band--ink .band__intro {
    color: rgba(244, 239, 232, 0.86);
  }
  /* The address is set at reading-plus size and left clickable: someone who
     wants to write now should not have to find the contact page first. */
  .band__address {
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    max-width: none;
  }
  .band__address a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    overflow-wrap: anywhere;
  }

  .band__action {
    margin: 1.75rem 0 0;
    max-width: none;
  }

  .beliefs {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
  }
  .beliefs__row {
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 36rem);
    gap: 0.35rem 3rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--color-line);
  }
  .beliefs__row:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .beliefs dt {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: 1.4;
    color: var(--color-navy);
  }
  .beliefs dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .routes {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: 0;
  }
  .routes li {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 34rem);
    gap: 0.3rem 3rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--color-line);
    align-items: baseline;
  }
  .routes li:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  /* These are the page's navigation, not links inside a sentence, so they get
     a tap target rather than a text box. Inline-block keeps them on the
     baseline the description beside them is aligned to. */
  .routes a {
    display: inline-block;
    padding-block: 0.4rem;
    font-family: var(--font-ui);
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.2em;
  }
  .routes a:hover {
    color: var(--accent);
  }
  .routes span {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink-soft);
  }

  .entities {
    max-width: 36rem;
  }
  .entities__mark {
    margin: 0 0 0.75rem;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .entities h2 {
    font-weight: 400;
    margin: 0 0 1rem;
  }
  .entities p {
    margin: 0.55rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 42ch;
  }
  .entities__quiet {
    margin-top: 1.15rem;
    color: var(--color-ink-muted);
  }

  @media (max-width: 52rem) {
    /* Stacks in source order: heading, copy, then the diamond. Capped so it
       stays deliberate without taking a screen to itself. */
    .believe {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      justify-items: start;
    }
    .believe__gem img {
      width: min(38vw, 9rem);
    }
  }

  @media (max-width: 48rem) {
    .beliefs__row,
    .routes li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
      padding-block: 1.1rem;
    }
  }
</style>
