---
import Base from '../layouts/Base.astro';
import DoorUniverseBand from '../components/DoorUniverseBand.astro';
import { contactMeishHref, contactMeishLabel, fitYouHref, fitYouLabel, fitBusinessHref, fitBusinessLabel } from '../data/hatchling-nav';
---

<Base
  title="About Meish — human experience & useful tools"
  description="Meish specialises in human experience — understanding it, reviewing it and making it better. Human-centered tools when the right ones do not exist yet. English and Finnish."
>
  <DoorUniverseBand
    eyebrow="About"
    title="About Meish"
    lead="We specialise in human experience — understanding it, reviewing it and making it better. Technology should create more room for meaningful work and life."
  >
    <p class="door-band-langs">We work in English and Finnish. · Palvelemme myös suomeksi.</p>
  </DoorUniverseBand>

  <section class="section container door-body">
    <h2>What Meish offers now</h2>
    <ul>
      <li>
        <a href="/for-business"><strong>Meish &amp; Your Business</strong></a> — Possibility Map,
        Build, Friction Removal, Human Experience Review, and deeper engagements.
      </li>
      <li>
        <a href="/for-you"><strong>Meish &amp; You</strong></a> — personal growth, decision support
        and everyday usefulness.
      </li>
      <li>
        <a href="/tools"><strong>Meish Tools</strong></a> — focused instruments when the right tool
        already exists.
      </li>
      <li>
        <a href="/gifts"><strong>Gifts for You</strong></a> — free PDF starters.
      </li>
    </ul>

    <h2>What we believe</h2>
    <p>
      Human experience is our North Star. Every experience is designed — on purpose or by
      accident. When you can see what actually happens for the people inside an experience, you
      can protect what works and fix what quietly hurts — without removing human choice.
      Read our <a href="/privacy">privacy and boundaries</a>.
    </p>

    <p class="actions">
      <a class="button button--primary" href={contactMeishHref}>{contactMeishLabel}</a>
      <a class="button button--ghost" href="/for-business">See business offers</a>
      <a class="button button--ghost" href={fitYouHref}>{fitYouLabel}</a>
      <a class="button button--ghost" href={fitBusinessHref}>{fitBusinessLabel}</a>
    </p>
  </section>
</Base>

<style>
  .door-band-langs {
    margin: 0.75rem auto 0;
    font-size: 0.78rem;
    color: #6f87a8;
    max-width: none;
  }
  .door-body {
    padding-top: var(--space-xl);
  }
  .door-body h2 {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
  .door-body h2:first-child {
    margin-top: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
</style>
