---
import Base from '../layouts/Base.astro';
import DestinationMark from '../components/DestinationMark.astro';
import { fitCallHref, fitCallLabel, contactEmail } from '../data/hatchling-nav';
---
<Base
  title="Contact — Meish"
  description="Write to Jenni. 20-minute Fit Check is free. jenni@meish.work"
>
  <section class="section container door-page">
    <p class="eyebrow arrive">
      <DestinationMark size="page" />
      Contact
    </p>
    <h1>Start with one conversation</h1>
    <p class="lead">
      If you are not sure which offer fits, book a 20-minute Fit Check — free.
      Or write to Jenni.
    </p>

    <p class="actions">
      <a class="button button--primary" href={fitCallHref}>{fitCallLabel}</a>
    </p>

    <h2>Email</h2>
    <p>
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </p>
    <p>When you write, it helps to include:</p>
    <ul>
      <li>Your business or organisation</li>
      <li>What you are trying to improve or decide</li>
      <li>The best way to reach you</li>
    </ul>
  </section>
</Base>

<style>
  .arrive {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
</style>
