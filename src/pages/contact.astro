---
import Base from '../layouts/Base.astro';
import DoorUniverseBand from '../components/DoorUniverseBand.astro';
import {
  fitYouHref,
  fitYouLabel,
  fitBusinessHref,
  fitBusinessLabel,
  contactEmail,
  contactMeishHref,
  contactMeishLabel,
} from '../data/hatchling-nav';
import { meishMailto } from '../lib/meish-mailto';

const phone = '044 343 4003';
const phoneTel = '+358443434003';
const shouldMeishMail = meishMailto({
  product: 'Should we Meish this',
  page: 'Contact',
  section: 'Primary',
  cta: 'Should we Meish this',
});
---

<Base
  title="Contact Meish — Should we Meish this?"
  description="Contact Meish. You can come with the situation — you do not need the answer. Meish & You or Meish & Your Business Fit Check, or Possibility Map. English and Finnish."
>
  <DoorUniverseBand
    eyebrow="Contact"
    title="Should we Meish this?"
    lead="You can come with the situation. You do not have to come with the answer."
  >
    <p class="door-band-langs">We work in English and Finnish. · Palvelemme myös suomeksi.</p>
  </DoorUniverseBand>

  <section class="section container door-body">
    <p class="lead">
      An idea, an irritation, an opportunity, a question — or something you cannot quite name yet —
      is enough to start.
    </p>

    <p class="actions">
      <a class="button button--primary" href={shouldMeishMail}>Should we Meish this?</a>
      <a class="button button--ghost" href={fitYouHref}>{fitYouLabel}</a>
      <a class="button button--ghost" href={fitBusinessHref}>{fitBusinessLabel}</a>
    </p>
    <p class="fit-note">
      Free. Evaluates whether Meish is useful. Not a health or fitness check.
    </p>

    <h2>Email</h2>
    <p>
      <a href={contactMeishHref}>{contactEmail}</a>
    </p>

    <h2>Phone</h2>
    <details class="phone-reveal">
      <summary>Show phone number</summary>
      <p>
        <a href={`tel:${phoneTel}`}>{phone}</a>
      </p>
    </details>

    <h2>When you write, it helps to include</h2>
    <ul>
      <li>Your name</li>
      <li>Email (if not obvious from the message)</li>
      <li>What you are thinking about — even roughly</li>
      <li>Optional: this is for me / my business / something else</li>
    </ul>

    <p class="actions">
      <a class="button button--ghost" href="/for-business">Meish &amp; Your Business</a>
      <a class="button button--ghost" href="/for-you">Meish &amp; You</a>
      <a class="button button--ghost" href="/gifts">Free gift</a>
    </p>
  </section>
</Base>

<style>
  .door-band-langs {
    margin: 0.75rem auto 0;
    font-size: 0.78rem;
    color: #6f87a8;
    max-width: none;
  }
  .door-body {
    padding-top: var(--space-xl);
  }
  .lead {
    max-width: 48ch;
    color: var(--text-soft);
    font-size: var(--text-md);
  }
  .fit-note {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: 48ch;
  }
  .door-body h2 {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .phone-reveal {
    margin-top: var(--space-sm);
  }
</style>
