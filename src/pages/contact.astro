---
import Base from '../layouts/Base.astro';
import DestinationMark from '../components/DestinationMark.astro';
import { fitCallHref, fitCallLabel, contactEmail } from '../data/hatchling-nav';
---
<Base
  title="Contact — Meish"
  description="Write to Jenni. Should We Meish This? is 20 minutes and free. jenni@meish.work"
>
  <section class="section container">
    <p class="eyebrow arrive">
      <DestinationMark kind="contact" size="page" />
      Contact
    </p>
    <h1>Start with one conversation.</h1>
    <p class="lead">
      You are in Contact. The letter mark from the Universe is the same one as here.
      If you are not sure which offer fits, begin with Should We Meish This? — 20 minutes, free.
    </p>

    <p>
      <a class="button button--primary" href={fitCallHref}>{fitCallLabel}</a>
    </p>

    <h2>Email</h2>
    <p>
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </p>
    <p>When you write, it helps to include:</p>
    <ul>
      <li>Your business or organisation</li>
      <li>What you are trying to improve or decide</li>
      <li>The best way to reach you</li>
    </ul>

    <p>
      <a href="/for-business">See all Meish for Your Business offers →</a>
    </p>
  </section>
</Base>

<style>
  .arrive {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
</style>
