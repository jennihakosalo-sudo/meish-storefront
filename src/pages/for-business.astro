---
/**
 * For Your Business.
 *
 * Opens with recognition, then goes straight to what can be bought. The
 * themes come after the products, not before: a decision-maker scanning this
 * page wants to know what exists and what it costs, and will read the
 * reasoning only once something has caught their attention.
 */
import Base from '../layouts/Base.astro';
import LightHero from '../components/LightHero.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductDetail from '../components/ProductDetail.astro';
import { getProduct as getCatalogProduct } from '../data/meish-products';
import { closing, contactAction, getProductDetail, pageHeroes } from '../data/site-content';

/* The three a business is most likely to be here for, described at length.
   Order is deliberate: direction first, then experience, then the leader's
   own thinking. */
const detailed = [
  getProductDetail('recognition-sprint'),
  getProductDetail('human-experience-review'),
  getProductDetail('thought-leadership-sprint'),
];

/* Real products, but not what this page is arguing for. Named and priced so
   nothing is hidden, and short so they do not compete with the three above. */
const alsoAvailable = [
  getCatalogProduct('behavior-composition-audit')!,
  getCatalogProduct('leadership-tool-sets')!,
  getCatalogProduct('business-factory')!,
];

const themes = [
  ['Clarity', 'Knowing what is actually being decided, and by whom.'],
  ['Flow', 'A week that runs without friction everyone stopped noticing years ago.'],
  ['Human experience', 'What it is genuinely like to be a customer, or an employee, here.'],
  ['Decision-making', 'Fewer decisions carried around unmade.'],
  ['Useful AI', 'What should be automated, what should stay human, what should be removed.'],
  ['Business direction', 'Which of the possible next moves deserves the first test.'],
];
---

<Base
  title="Meish for Your Business — recognition, then the first useful test"
  description="Find the strongest next direction and define the first test. Recognition Sprint from €590 + VAT, Human Experience Review from €950 + VAT, Thought Leadership Sprint from €690 + VAT."
>
  <LightHero {...pageHeroes.business} action={null} />

  <section class="band" aria-labelledby="offers-title">
    <div class="container">
      <h2 id="offers-title">What we can do together</h2>
      <div class="details">
        {detailed.map((p) => <ProductDetail product={p} />)}
      </div>
    </div>
  </section>

  <section class="band band--soft" aria-labelledby="also-title">
    <div class="container">
      <h2 id="also-title">Also available</h2>
      <div class="products">
        {alsoAvailable.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="themes-title">
    <div class="container">
      <h2 id="themes-title">What tends to come up</h2>
      <dl class="themes">
        {
          themes.map(([name, note]) => (
            <div class="themes__row">
              <dt>{name}</dt>
              <dd>{note}</dd>
            </div>
          ))
        }
      </dl>
      <p class="band__intro">
        None of this is generic business consulting. We do not arrive with a framework and look
        for somewhere to apply it. We look at what is actually there first.
      </p>
    </div>
  </section>

  <section class="band band--ink on-dark" aria-labelledby="start-title">
    <div class="container">
      <h2 id="start-title">Not sure which one?</h2>
      <p class="band__intro">
        Describe the situation in a couple of sentences. We will say whether any of this is useful
        here — and which one to start with if it is.
      </p>
      <p class="band__brief">{closing.heading}</p>
      <p class="band__action">
        <a class="button button--primary" href={contactAction.href}>{contactAction.label}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .band {
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  .band--soft {
    background: var(--color-cream);
  }
  .band--ink {
    background: var(--meish-navy);
    color: var(--meish-ivory);
  }
  .band--ink :global(h2) {
    color: var(--meish-ivory);
  }
  .band h2 {
    font-weight: 400;
  }
  .band__intro {
    margin: 1.6rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.64;
    max-width: 52ch;
    color: var(--color-ink-soft);
  }
  .band--ink .band__intro {
    color: rgba(244, 239, 232, 0.86);
  }
  .band__action {
    margin: 1.75rem 0 0;
    max-width: none;
  }
  .band__brief {
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--meish-ivory);
  }

  /* One product per row, stacked. Three long descriptions side by side would
     be three columns of text nobody reads across. */
  .details {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem);
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .products > :global(.product--featured) {
    grid-column: 1 / -1;
  }

  .themes {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
  }
  .themes__row {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 38rem);
    gap: 0.3rem 2.5rem;
    padding-block: 0.95rem;
    border-top: 1px solid var(--color-line);
  }
  .themes__row:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .themes dt {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 400;
  }
  .themes dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  @media (max-width: 48rem) {
    .themes__row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
      padding-block: 1rem;
    }
  }
</style>
