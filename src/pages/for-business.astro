---
import Base from '../layouts/Base.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
import DoorUniverseBand from '../components/DoorUniverseBand.astro';
import { fitBusinessHref, fitBusinessLabel, contactMeishHref, contactMeishLabel } from '../data/hatchling-nav';
import { SITE_ORIGIN } from '../lib/meish-mailto';

const possibilityMapSchema = {
  '@type': 'Service',
  '@id': `${SITE_ORIGIN}/for-business/#possibility-map`,
  name: 'Possibility Map',
  description:
    'Business diagnostic for human experience, workflow and AI opportunities: three concrete routes, one recommendation, and 30-day actions. Delivered within five business days of the interview.',
  provider: { '@id': `${SITE_ORIGIN}/#organization` },
  url: `${SITE_ORIGIN}/for-business/#possibility-map`,
  areaServed: 'Finland',
  availableLanguage: ['en', 'fi'],
  offers: {
    '@type': 'Offer',
    price: '590.00',
    priceCurrency: 'EUR',
    category: 'Gamma Test Phase',
    description: '€590 + VAT 25.5%. Regular price €950 + VAT 25.5%.',
    url: `${SITE_ORIGIN}/for-business/#possibility-map`,
  },
};
---

<Base
  title="Meish & Your Business — Possibility Map & offers"
  description="Outside view, friction removal, interview-to-product work and useful AI where it helps. Possibility Map €590 + VAT. Optional 20-minute Meish & Your Business Fit Check. English and Finnish."
  schema={possibilityMapSchema}
>
  <DoorUniverseBand
    eyebrow="Meish & Your Business"
    title="Meish & Your Business"
    lead="When something could work better — but you cannot yet see exactly what. Clear offers. Concrete outputs."
  >
    <p class="door-band-langs">We work in English and Finnish. · Palvelemme myös suomeksi.</p>
  </DoorUniverseBand>

  <section class="section container door-body">
    <h2>When Meish may be useful</h2>
    <ul class="situations">
      <li>You know something could work better, but you cannot yet see exactly what.</li>
      <li>You want an outside view before investing in a larger solution.</li>
      <li>You want to understand what customers or employees actually experience.</li>
      <li>You have valuable expertise that could become a product or tool.</li>
      <li>You want to see where AI could genuinely help.</li>
      <li>You need a small custom tool rather than another large project.</li>
      <li>You want to remove unnecessary friction — or test an idea quickly.</li>
    </ul>

    <h2>Start here</h2>
    <p>
      Optional <a href={fitBusinessHref}>{fitBusinessLabel}</a>. Not a health check.
      Or go straight to
      <a href="#possibility-map">Possibility Map</a> (€590 + VAT).
      Prefer email? <a href={contactMeishHref}>{contactMeishLabel}</a>.
    </p>
  </section>
  <ProductCatalog />
</Base>

<style>
  .door-band-langs {
    margin: 0.75rem auto 0;
    font-size: 0.78rem;
    color: #6f87a8;
    max-width: none;
  }
  .door-body {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-md);
  }
  .door-body h2 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin: var(--space-lg) 0 var(--space-sm);
  }
  .door-body h2:first-child {
    margin-top: 0;
  }
  .situations {
    max-width: 58ch;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.45rem;
    color: var(--text-soft);
  }
</style>
