---
import Base from '../layouts/Base.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
import DestinationMark from '../components/DestinationMark.astro';
---

<Base
  title="Meish for Your Business — offers & pricing"
  description="Meish for Your Business: 20-minute Fit Check, free. Possibility Map 590 € + VAT (Gamma Test Phase)."
>
  <section class="section container door-page">
    <p class="eyebrow arrive">
      <DestinationMark size="page" />
      For Your Business
    </p>
    <h1>Clear offers. A clear first path.</h1>
    <p class="lead">
      Possibility Map is 590 € + VAT. If you want to see whether Meish is useful,
      start with a 20-minute Fit Check — free.
    </p>
  </section>
  <ProductCatalog />
</Base>

<style>
  .arrive {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .door-page { padding-bottom: var(--space-md); }
</style>
