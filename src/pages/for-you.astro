---
import Base from '../layouts/Base.astro';
import { fitCheckHref } from '../data/hatchling-nav';
---
<Base
  title="Meish for You — support for individuals | Meish"
  description="Meish for You — personal growth, decision support, wellbeing and everyday guidance."
>
  <section class="section container">
    <p class="eyebrow">Meish for You</p>
    <h1>Meish for You</h1>
    <p class="lead">
      Not everything Meish makes is for a business. Meish for You is the personal side — helping
      individuals think, decide, and feel a little lighter.
    </p>

    <h2>What lives here</h2>
    <ul>
      <li>Personal growth and reflection</li>
      <li>Decision support for hard choices</li>
      <li>Wellbeing and everyday guidance</li>
    </ul>

    <p>
      More is coming. For now, the simplest way in is a conversation.
    </p>

    <p>
      <a class="button button--primary" href={fitCheckHref}>Book a Fit Check</a>
      <a class="button button--ghost" href="/contact">Get in touch</a>
    </p>
  </section>
</Base>
