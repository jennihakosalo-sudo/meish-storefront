---
import Base from '../layouts/Base.astro';
import DoorUniverseBand from '../components/DoorUniverseBand.astro';
import { contactMeishHref, contactMeishLabel, fitYouHref, fitYouLabel } from '../data/hatchling-nav';
---

<Base
  title="Meish & You — useful things for being a human"
  description="Useful things for being a human: noticing, decisions, transitions, less unnecessary friction. Free gift and 20-minute Meish & You Fit Check. English and Finnish."
>
  <DoorUniverseBand
    eyebrow="Meish & You"
    title="Meish & You"
    lead="Useful things for being a human — practical, curious, slightly strange. Not a wellness clinic."
  >
    <p class="door-band-langs">We work in English and Finnish. · Palvelemme myös suomeksi.</p>
  </DoorUniverseBand>

  <section class="section container door-body">
    <h2>What this is for</h2>
    <ul>
      <li>Noticing what is actually happening in your week</li>
      <li>Thinking and decisions with less fog</li>
      <li>Transitions and everyday friction</li>
      <li>Small useful questions and tools</li>
      <li>Perspective — without therapy framing</li>
    </ul>

    <h2>Use something now</h2>
    <p>
      <a href="/gifts#clarity-starter"><strong>Clarity Starter (PDF)</strong></a>
      — a free one-page gift. Download, print, write by hand.
    </p>
    <p>
      Or a free <a href={fitYouHref}>{fitYouLabel}</a>. Not a fitness test.
    </p>

    <h2>If this is also about work</h2>
    <p>
      Continue to
      <a href="/for-business">Meish &amp; Your Business</a>
      — especially
      <a href="/for-business#possibility-map">Possibility Map</a>.
    </p>

    <p class="actions">
      <a class="button button--primary" href="/gifts">Take a free gift</a>
      <a class="button button--ghost" href={fitYouHref}>{fitYouLabel}</a>
      <a class="button button--ghost" href={contactMeishHref}>{contactMeishLabel}</a>
    </p>
  </section>
</Base>

<style>
  .door-body {
    padding-top: var(--space-xl);
  }
  .door-body h2 {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
  .door-body h2:first-child {
    margin-top: 0;
  }
  .door-body ul {
    max-width: 48ch;
    color: var(--text-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
</style>
