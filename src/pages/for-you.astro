---
import Base from '../layouts/Base.astro';
import DestinationMark from '../components/DestinationMark.astro';
import { contactMeishHref, contactMeishLabel, fitCallHref, fitCallLabel } from '../data/hatchling-nav';
---

<Base
  title="Meish for You — Meish"
  description="Meish for You — personal growth, decision support, wellbeing and everyday guidance. We work in English and Finnish."
>
  <section class="section container door-page">
    <p class="eyebrow arrive">
      <DestinationMark size="page" />
      For You
    </p>
    <h1>Meish for You</h1>
    <p class="lead">
      Personal work: thinking, decisions, resilience, transitions, and a little more ease in
      ordinary days. Technology should support you — without asking you to become more machine-like.
    </p>
    <p class="langs">We work in English and Finnish. · Palvelemme myös suomeksi.</p>

    <ul>
      <li>Thinking and decision support</li>
      <li>Everyday friction and family life</li>
      <li>Personal AI assistants and practical tools</li>
    </ul>

    <p class="actions">
      <a class="button button--primary" href={contactMeishHref}>{contactMeishLabel}</a>
      <a class="button button--ghost" href={fitCallHref}>{fitCallLabel}</a>
    </p>
  </section>
</Base>

<style>
  .arrive {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .langs {
    margin: var(--space-sm) 0 var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
</style>
