---
import Base from '../layouts/Base.astro';
import DestinationMark from '../components/DestinationMark.astro';
import { fitCallHref, fitCallLabel } from '../data/hatchling-nav';
---
<Base
  title="Meish for You — Meish"
  description="Meish for You — personal growth, decision support, wellbeing and everyday guidance."
>
  <section class="section container door-page">
    <p class="eyebrow arrive">
      <DestinationMark size="page" />
      For You
    </p>
    <h1>Meish for You</h1>
    <p class="lead">
      Personal work: thinking, decisions, and a little more ease in ordinary days.
      More will be published here. The simplest way in is a conversation.
    </p>

    <ul>
      <li>Personal growth and reflection</li>
      <li>Decision support for hard choices</li>
      <li>Wellbeing and everyday guidance</li>
    </ul>

    <p class="actions">
      <a class="button button--primary" href={fitCallHref}>{fitCallLabel}</a>
      <a class="button button--ghost" href="/contact">Write to Jenni</a>
    </p>
  </section>
</Base>

<style>
  .arrive {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
</style>
