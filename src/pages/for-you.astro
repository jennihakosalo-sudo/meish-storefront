---
import Base from '../layouts/Base.astro';
import DestinationMark from '../components/DestinationMark.astro';
import { fitCallHref, fitCallLabel } from '../data/hatchling-nav';
---
<Base
  title="Meish for You — support for individuals | Meish"
  description="Meish for You — personal growth, decision support, wellbeing and everyday guidance."
>
  <section class="section container">
    <p class="eyebrow arrive">
      <DestinationMark kind="you" size="page" />
      Meish for You
    </p>
    <h1>Meish for You</h1>
    <p class="lead">
      You are in the personal side. The moon mark from the Universe is the same one as here.
      Meish for You helps individuals think, decide, and feel a little lighter.
    </p>

    <h2>What lives here</h2>
    <ul>
      <li>Personal growth and reflection</li>
      <li>Decision support for hard choices</li>
      <li>Wellbeing and everyday guidance</li>
    </ul>

    <p>
      More is coming. For now, the simplest way in is a conversation.
    </p>

    <p>
      <a class="button button--primary" href={fitCallHref}>{fitCallLabel}</a>
      <a class="button button--ghost" href="/contact">Get in touch</a>
    </p>
  </section>
</Base>

<style>
  .arrive {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
</style>
