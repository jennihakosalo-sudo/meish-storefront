---
import Base from '../layouts/Base.astro';
import DestinationMark from '../components/DestinationMark.astro';
import { fitCallHref, fitCallLabel, contactEmail } from '../data/hatchling-nav';
---

<Base
  title="Gifts for You — Meish"
  description="Meish Gifts for You: free downloads. None are published on this site yet."
>
  <section class="section container door-page">
    <p class="eyebrow arrive">
      <DestinationMark size="page" />
      Gifts for You
    </p>
    <h1>Free downloads</h1>
    <p class="lead">
      Gifts for You are free files you can take with you. None are published here yet.
    </p>
    <p>
      When paid downloads exist, their own OST instructions sit in the product description.
    </p>
    <p class="actions">
      <a class="button button--primary" href={fitCallHref}>{fitCallLabel}</a>
      <a class="button button--ghost" href={`mailto:${contactEmail}`}>Write to Jenni</a>
    </p>
  </section>
</Base>

<style>
  .arrive {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
</style>
