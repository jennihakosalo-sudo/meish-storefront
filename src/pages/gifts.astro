---
import Base from '../layouts/Base.astro';
import { fitCallHref, fitCallLabel, contactEmail } from '../data/hatchling-nav';
---

<Base
  title="Gifts for You — Meish"
  description="Meish Gifts for You: free downloads. Paid downloads include their own OST instructions in the product description."
>
  <section class="section container">
    <p class="eyebrow">Gifts for You</p>
    <h1>Free downloads</h1>
    <p class="lead">
      Gifts for You are free files you can download. Paid downloads, when they exist,
      include their own OST instructions in the product description.
    </p>
    <p>
      No free downloads are published on this site yet. Nothing is invented here
      while the files are still being prepared.
    </p>
    <p>
      This is not the print shop. Printed products stay off the public Hatchling site.
    </p>
    <p>
      <a class="button button--primary" href={fitCallHref}>{fitCallLabel}</a>
      <a class="button button--ghost" href={`mailto:${contactEmail}`}>Write to Jenni</a>
    </p>
  </section>
</Base>
