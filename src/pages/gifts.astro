---
import Base from '../layouts/Base.astro';
import DoorUniverseBand from '../components/DoorUniverseBand.astro';
import { contactMeishHref, contactMeishLabel, contactEmail } from '../data/hatchling-nav';
---

<Base
  title="Gifts for You — free Meish starters"
  description="Free Meish Clarity Starter PDF — a one-page worksheet. Keep it, no signup. We work in English and Finnish."
>
  <DoorUniverseBand
    eyebrow="Gifts for You"
    title="Gifts for You"
    lead="A free Meish gift you can use today — keep it, no signup."
  >
    <p class="door-band-langs">We work in English and Finnish. · Palvelemme myös suomeksi.</p>
  </DoorUniverseBand>

  <section class="section container door-body">
    <article class="gift-card" id="clarity-starter">
      <p class="eyebrow">Free gift · PDF worksheet</p>
      <h2>Meish Clarity Starter</h2>
      <p>
        One page. Five questions. One next move for this week. Download, print, write by hand —
        about 10 quiet minutes.
      </p>
      <ol class="gift-how">
        <li>Download the PDF.</li>
        <li>Print it (or write on a blank page).</li>
        <li>Answer each question in one short line.</li>
        <li>Circle one next move — that is enough for now.</li>
      </ol>
      <p class="actions">
        <a class="button button--primary" href="/gifts/meish-clarity-starter.pdf" download>
          Download your free gift (PDF)
        </a>
        <a class="button button--ghost" href={contactMeishHref}>{contactMeishLabel}</a>
      </p>
    </article>

    <p class="langs">
      Optional help with the next step: <a href={contactMeishHref}>{contactMeishLabel}</a> ·
      {contactEmail}
    </p>
  </section>
</Base>

<style>
  .door-body {
    padding-top: var(--space-xl);
  }
  .gift-card {
    padding: var(--space-xl);
    border: 1px solid rgba(11, 16, 32, 0.12);
    background: linear-gradient(165deg, rgba(234, 246, 255, 0.95), rgba(255, 255, 255, 0.9));
    border-radius: var(--radius-md);
  }
  .gift-card h2 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .gift-how {
    margin: var(--space-md) 0;
    padding-left: 1.2rem;
    color: var(--text-soft);
    max-width: 40ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .langs {
    margin-top: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
