---
import Base from '../layouts/Base.astro';
import MeishUniverseScene from '../components/MeishUniverseScene.astro';
import {
  contactMeishHref,
  contactMeishLabel,
  fitCallHref,
  fitCallLabel,
} from '../data/hatchling-nav';
import { meishMailto } from '../lib/meish-mailto';

const mapMail = meishMailto({
  product: 'Possibility Map',
  page: 'Homepage',
  section: 'Offers',
  cta: 'Ask about Possibility Map',
});

const frictionMail = meishMailto({
  product: 'Friction Removal',
  page: 'Homepage',
  section: 'Offers',
  cta: 'Ask about Friction Removal',
});

const reviewMail = meishMailto({
  product: 'Human Experience Review',
  page: 'Homepage',
  section: 'Offers',
  cta: 'Ask about a Review',
});

const shouldMeishMail = meishMailto({
  product: 'Should we Meish this',
  page: 'Homepage',
  section: 'CTA',
  cta: 'Should we Meish this',
});
---

<Base
  title="Meish — human experience is our North Star"
  description="Meish notices what is happening in human experience — then makes useful tools, maps and changes. Possibility Map €590 + VAT. English and Finnish."
  universeHome={true}
>
  <MeishUniverseScene />

  <!-- Strong hook — dark band, editorial, not SaaS cards -->
  <section class="band band--dark" aria-label="Call Meish">
    <div class="container band__inner">
      <p class="band__kicker">Start</p>
      <h2 class="band__display">Call Meish.<br />Get something useful.</h2>
      <p class="band__lead">
        Tell us what makes work unnecessarily difficult.
      </p>
      <p class="band__body">
        We build something useful, make sure it works, and make sure you know how to use it.
      </p>
      <p class="band__fi" lang="fi">
        Kerro mikä työssäsi vie turhaan aikaa, energiaa tai hermoja. Meish tekee siihen toimivan
        ratkaisun, varmistaa että se toimii — ja opettaa sinut käyttämään sitä.
      </p>

      <ol class="steps">
        <li>
          <span class="steps__n">1</span>
          <strong>Tell us what is hard</strong>
        </li>
        <li>
          <span class="steps__n">2</span>
          <strong>We build something useful</strong>
        </li>
        <li>
          <span class="steps__n">3</span>
          <strong>You leave with a solution you can actually use</strong>
        </li>
      </ol>
    </div>
  </section>

  <!-- Products immediately -->
  <section class="band band--dark band--offers" id="work-with-meish" aria-label="Work with Meish">
    <div class="container">
      <p class="band__kicker">Work with Meish</p>
      <h2 class="band__display band__display--sm">Offers</h2>

      <article class="offer offer--feature" id="possibility-map-example">
        <p class="offer__eyebrow">For Your Business · Gamma Test Phase</p>
        <h3 class="offer__name">Possibility Map</h3>
        <p class="offer__hook">You bring the situation. We map what could be possible.</p>
        <p class="offer__note">
          A clear map of meaningful possibilities — three routes, one recommendation, and practical
          next steps for 30 days.
        </p>
        <ul class="offer__list">
          <li>For B2B entrepreneurs and decision-makers</li>
          <li>60-minute interview</li>
          <li>Visible map, three routes, recommendation</li>
          <li>Delivered within five business days</li>
        </ul>
        <p class="offer__meta">
          <strong>€590 + VAT 25.5%</strong>
          <span> · Regular €950 + VAT 25.5%</span>
        </p>
        <p class="offer__actions">
          <a class="cta cta--primary" href={mapMail}>Ask about Possibility Map</a>
        </p>
      </article>

      <div class="offer-rail" role="list">
        <article class="offer" role="listitem">
          <p class="offer__eyebrow">For Your Business</p>
          <h3 class="offer__name">Friction Removal</h3>
          <p class="offer__hook">
            Find and remove unnecessary work — repeated tasks, unclear processes, avoidable friction.
          </p>
          <p class="offer__meta"><strong>From €1,899 + VAT 25.5%</strong></p>
          <p class="offer__actions">
            <a class="cta" href={frictionMail}>Ask about Friction Removal</a>
          </p>
        </article>

        <article class="offer" role="listitem">
          <p class="offer__eyebrow">For Your Business</p>
          <h3 class="offer__name">Human Experience Review</h3>
          <p class="offer__hook">
            Outside view on how a service, journey, place or experience actually feels.
          </p>
          <p class="offer__meta">Scope and price after a conversation</p>
          <p class="offer__actions">
            <a class="cta" href={reviewMail}>Ask about a Review</a>
          </p>
        </article>
      </div>

      <p class="band__more">
        More on <a href="/for-business">Meish for Your Business</a>
        · <a href="/tools">Meish Tools</a>
        · <a href="/gifts">Gifts for You</a>
      </p>
      <p class="band__fit">
        Not sure which offer fits?
        <a href={fitCallHref}>{fitCallLabel}</a>
        — free, 20 minutes. Optional.
      </p>
    </div>
  </section>

  <section class="band band--pearl" aria-label="What Meish does">
    <div class="container">
      <h2 class="pearl__title">What does Meish do?</h2>
      <p class="pearl__sub">We notice things. Then we make useful things out of what we notice.</p>
      <ul class="pearl__list">
        <li><strong>Notice</strong> Find what is easy to miss from inside a business or situation.</li>
        <li><strong>Understand</strong> Make human experience, friction and possibilities visible.</li>
        <li><strong>Make</strong> Turn observation into tools, maps, content and practical solutions.</li>
        <li><strong>Test</strong> Try small ideas before they become large projects.</li>
        <li><strong>Use AI where it helps</strong> Not AI for its own sake.</li>
      </ul>
    </div>
  </section>

  <section class="band band--pearl band--alt" aria-label="What you can get">
    <div class="container">
      <h2 class="pearl__title">What can you get from Meish?</h2>
      <ul class="pearl__get">
        <li>A fresh pair of eyes</li>
        <li>A clearer picture</li>
        <li>A small useful tool</li>
        <li>A custom tool from your knowledge</li>
        <li>A human experience review</li>
        <li>An AI possibility map</li>
        <li>Something we have not made yet</li>
      </ul>
    </div>
  </section>

  <section class="band band--pearl" aria-label="Where to begin">
    <div class="container">
      <h2 class="pearl__title">Where would you like to begin?</h2>
      <div class="door-row">
        <a class="door" href="/for-business">
          <strong>Meish for Your Business</strong>
          <span>Outside view, friction, AI where it helps, tools from your expertise.</span>
        </a>
        <a class="door" href="/for-you">
          <strong>Meish for You</strong>
          <span>Useful things for being a human — decisions, transitions, everyday ease.</span>
        </a>
        <a class="door" href="/tools">
          <strong>Tools</strong>
          <span>Things you can use — including without us.</span>
        </a>
        <a class="door" href="/gifts">
          <strong>Gifts for You</strong>
          <span>Take something useful with you. Free. No signup.</span>
        </a>
      </div>
    </div>
  </section>

  <section class="band band--pearl" aria-label="Contact">
    <div class="container">
      <h2 class="pearl__title">Should we Meish this?</h2>
      <p class="pearl__sub">You can come with the situation. You do not have to come with the answer.</p>
      <p class="pearl__actions">
        <a class="cta cta--ink" href={shouldMeishMail}>Should we Meish this?</a>
        <a class="cta cta--ink" href={contactMeishHref}>{contactMeishLabel}</a>
        <a class="cta cta--ink" href="/gifts">Take a free gift</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .band {
    padding: clamp(3rem, 7vw, 5rem) 0;
  }
  .band--dark {
    background: #050510;
    color: #e8eef8;
  }
  .band--offers {
    border-top: 1px solid rgba(232, 238, 248, 0.08);
  }
  .pearl__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .cta--ink {
    border-color: rgba(11, 16, 32, 0.28);
    color: #0b1020;
  }
  .cta--ink:hover {
    color: #0b1020;
    border-color: #4a48b8;
  }
  .band--pearl {
    background: #f7f3ea;
    color: #0b1020;
  }
  .band--alt {
    background: #efe9dc;
  }

  .band__inner {
    max-width: 42rem;
  }

  .band__kicker {
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(126, 215, 227, 0.85);
  }

  .band__display {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #f4f7fc;
    max-width: 14ch;
  }
  .band__display--sm {
    font-size: clamp(2rem, 4vw, 2.75rem);
    max-width: 20ch;
  }

  .band__lead {
    margin: 0 0 0.65rem;
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.4;
    color: rgba(244, 247, 252, 0.9);
    max-width: 36ch;
  }

  .band__body {
    margin: 0 0 1rem;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.45;
    color: rgba(232, 238, 248, 0.78);
    max-width: 42ch;
  }

  .band__fi {
    margin: 0 0 2rem;
    font-size: 1.05rem;
    line-height: 1.45;
    color: rgba(232, 238, 248, 0.58);
    max-width: 44ch;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
    border-top: 1px solid rgba(232, 238, 248, 0.12);
    padding-top: 1.5rem;
  }
  .steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.85rem;
    align-items: start;
  }
  .steps__n {
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: #f7c873;
    padding-top: 0.2rem;
  }
  .steps strong {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 600;
    line-height: 1.25;
    color: #f4f7fc;
  }

  .offer--feature {
    margin: 1.75rem 0 2.25rem;
    padding: 1.75rem 0 2rem;
    border-top: 1px solid rgba(232, 238, 248, 0.14);
    border-bottom: 1px solid rgba(232, 238, 248, 0.14);
  }

  .offer__eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(126, 215, 227, 0.8);
  }

  .offer__name {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    color: #f4f7fc;
  }

  .offer__hook {
    margin: 0 0 0.65rem;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.4;
    color: rgba(244, 247, 252, 0.88);
    max-width: 44ch;
  }

  .offer__note {
    margin: 0 0 1rem;
    font-size: 1rem;
    color: rgba(232, 238, 248, 0.55);
  }

  .offer__list {
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    max-width: 36ch;
  }
  .offer__list li {
    position: relative;
    padding-left: 1rem;
    font-size: 1.05rem;
    line-height: 1.4;
    color: rgba(232, 238, 248, 0.78);
  }
  .offer__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: #7ed7e3;
  }

  .offer__meta {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    color: rgba(232, 238, 248, 0.7);
  }
  .offer__meta strong {
    color: #f4f7fc;
  }

  .offer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .offer-rail {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem 2rem;
    padding-top: 0.5rem;
  }
  .offer-rail .offer {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(232, 238, 248, 0.12);
  }
  .offer-rail .offer__name {
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
  }
  .offer-rail .offer__hook {
    font-size: clamp(1.05rem, 1.6vw, 1.15rem);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.1rem;
    border: 1px solid rgba(232, 238, 248, 0.28);
    background: transparent;
    color: #f4f7fc;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .cta:hover {
    text-decoration: none;
    color: #f4f7fc;
    border-color: #7ed7e3;
  }
  .cta--primary {
    background: rgba(106, 90, 205, 0.35);
    border-color: rgba(106, 90, 205, 0.65);
  }

  .band__more,
  .band__fit {
    margin: 1.75rem 0 0;
    font-size: 1.05rem;
    line-height: 1.45;
    color: rgba(232, 238, 248, 0.62);
    max-width: 48ch;
  }
  .band__more a,
  .band__fit a {
    color: #7ed7e3;
  }

  .pearl__title {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.12;
    color: #0b1020;
    max-width: 22ch;
  }
  .pearl__sub {
    margin: 0 0 1.75rem;
    font-size: clamp(1.2rem, 2.2vw, 1.4rem);
    line-height: 1.4;
    color: #2a3568;
    max-width: 40ch;
  }
  .pearl__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
    max-width: 48ch;
  }
  .pearl__list li {
    font-size: 1.12rem;
    line-height: 1.45;
    color: #2a3568;
  }
  .pearl__list strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: #0b1020;
    margin-bottom: 0.15rem;
  }
  .pearl__get {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 36ch;
  }
  .pearl__get li {
    font-size: 1.2rem;
    line-height: 1.35;
    color: #0b1020;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(11, 16, 32, 0.12);
  }

  .door-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .door {
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(11, 16, 32, 0.16);
    text-decoration: none;
    color: inherit;
  }
  .door:hover {
    text-decoration: none;
  }
  .door strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: #0b1020;
  }
  .door span {
    font-size: 1.08rem;
    line-height: 1.4;
    color: #2a3568;
  }

  @media (max-width: 900px) {
    .offer-rail,
    .door-row {
      grid-template-columns: 1fr;
    }
  }
</style>
