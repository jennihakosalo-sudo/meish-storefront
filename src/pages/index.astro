---
import Base from '../layouts/Base.astro';
import MeishUniverseScene from '../components/MeishUniverseScene.astro';
import {
  contactMeishHref,
  contactMeishLabel,
  fitCallHref,
  fitCallLabel,
} from '../data/hatchling-nav';
import { meishMailto } from '../lib/meish-mailto';

const mapMail = meishMailto({
  product: 'Possibility Map',
  page: 'Homepage',
  section: 'Offers',
  cta: 'Ask about Possibility Map',
});

const shouldMeishMail = meishMailto({
  product: 'Should we Meish this',
  page: 'Homepage',
  section: 'CTA',
  cta: 'Should we Meish this',
});
---

<Base
  title="Meish — human experience is our North Star"
  description="Meish notices what is happening in human experience — then makes useful tools, maps and changes. Possibility Map €590 + VAT. Fit Check free. English and Finnish."
  universeHome={true}
>
  <MeishUniverseScene />

  <section class="home-body section" aria-label="What Meish does">
    <div class="container">
      <h2>What does Meish do?</h2>
      <p class="home-lead">
        We notice things. Then we make useful things out of what we notice.
      </p>
      <ul class="do-list">
        <li>
          <strong>Notice</strong>
          Find what is easy to miss from inside a business, service or situation.
        </li>
        <li>
          <strong>Understand</strong>
          Make human experience, friction, expectations and possibilities visible.
        </li>
        <li>
          <strong>Make</strong>
          Turn interviews and observations into tools, maps, content and practical solutions.
        </li>
        <li>
          <strong>Test</strong>
          Try small ideas before they become large projects.
        </li>
        <li>
          <strong>Use AI where it helps</strong>
          Find useful AI opportunities — not AI for its own sake.
        </li>
      </ul>
      <p class="home-note">
        More about how we work: <a href="/about">About Meish</a>.
      </p>
    </div>
  </section>

  <section class="home-body section" aria-label="What you can get">
    <div class="container">
      <h2>What can you get from Meish?</h2>
      <ul class="get-list">
        <li>A fresh pair of eyes</li>
        <li>A clearer picture</li>
        <li>A small useful tool</li>
        <li>A custom tool from your knowledge</li>
        <li>A human experience review</li>
        <li>An AI possibility map</li>
        <li>Something we have not made yet</li>
      </ul>
      <p class="home-note">
        A Meish strength: interview → understand → a sellable or usable product.
      </p>
    </div>
  </section>

  <section class="home-body section home-body--doors" aria-label="Where to begin">
    <div class="container">
      <h2>Where would you like to begin?</h2>
      <div class="door-row">
        <a class="door-card" href="/for-business">
          <strong>For Your Business</strong>
          <span>Outside view, friction, AI where it helps, tools from your expertise.</span>
        </a>
        <a class="door-card" href="/for-you">
          <strong>For You</strong>
          <span>Useful things for being a human — decisions, transitions, everyday ease.</span>
        </a>
        <a class="door-card" href="/tools">
          <strong>Tools</strong>
          <span>Things you can use — including without us.</span>
        </a>
        <a class="door-card" href="/gifts">
          <strong>Gifts for You</strong>
          <span>Take something useful with you. Free. No signup.</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-body section" aria-label="Paid example" id="possibility-map-example">
    <div class="container offer-strip">
      <h2>One concrete example</h2>
      <article class="offer-strip__card">
        <p class="eyebrow">For Your Business · paid</p>
        <h3>Possibility Map</h3>
        <p class="offer-meta">Gamma Test Phase · <strong>€590 + VAT</strong> (regular €950 + VAT)</p>
        <p>
          You bring the situation. We map what could be possible — three routes, one recommendation,
          30-day actions. Delivered within five business days of the interview.
        </p>
        <ul class="offer-includes">
          <li>60-minute interview</li>
          <li>Visible Possibility Map + three progression options</li>
          <li>Recommendation + next 30 days</li>
          <li>AI review where it creates edge or saves time</li>
          <li>30-minute results walkthrough</li>
        </ul>
        <p class="actions">
          <a class="button button--primary" href={mapMail}>Ask about Possibility Map</a>
          <a class="button button--ghost" href="/for-business#possibility-map">Full business offers</a>
        </p>
      </article>
      <p class="offer-strip__note">
        Not sure if Meish fits?
        <a href={fitCallHref}>{fitCallLabel}</a>
        — free. Meish &amp; you / Meish &amp; your business. Not a health check.
      </p>
    </div>
  </section>

  <section class="home-body section home-body--better" aria-label="Start">
    <div class="container">
      <h2>Should we Meish this?</h2>
      <p class="lead">
        You can come with the situation. You do not have to come with the answer.
      </p>
      <p class="actions">
        <a class="button button--primary" href={shouldMeishMail}>Should we Meish this?</a>
        <a class="button button--ghost" href={fitCallHref}>{fitCallLabel}</a>
        <a class="button button--ghost" href={contactMeishHref}>{contactMeishLabel}</a>
        <a class="button button--ghost" href="/gifts">Take a free gift</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .home-body {
    background: #fffbf5;
    color: #020c59;
  }
  .home-body h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
  }
  .home-lead,
  .lead {
    color: var(--text-soft);
    max-width: 48ch;
    font-size: var(--text-md);
    margin-bottom: var(--space-md);
  }
  .home-note,
  .offer-strip__note {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: 52ch;
  }
  .do-list,
  .get-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-sm);
    max-width: 52ch;
  }
  .do-list li,
  .get-list li {
    color: var(--text-soft);
  }
  .do-list strong {
    display: block;
    font-family: var(--font-display);
    color: var(--color-navy);
    margin-bottom: 0.15rem;
  }
  .get-list {
    columns: 2;
    max-width: 40rem;
  }
  .door-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .door-card {
    display: grid;
    gap: 0.4rem;
    padding: var(--space-lg);
    border: 1px solid rgba(2, 12, 89, 0.12);
    background: rgba(255, 253, 249, 0.9);
    text-decoration: none;
    color: inherit;
  }
  .door-card:hover {
    text-decoration: none;
    border-color: rgba(105, 94, 219, 0.45);
  }
  .door-card strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .door-card span {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .offer-strip__card {
    margin-top: var(--space-md);
    padding: var(--space-xl);
    border: 1px solid rgba(251, 215, 159, 0.55);
    background: linear-gradient(165deg, rgba(251, 215, 159, 0.2), rgba(255, 253, 249, 0.96));
  }
  .offer-strip__card h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: var(--space-xs);
  }
  .offer-meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }
  .offer-includes {
    margin: var(--space-sm) 0 var(--space-md);
    padding-left: 1.2rem;
    color: var(--text-soft);
    max-width: 48ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  @media (max-width: 900px) {
    .door-row,
    .get-list {
      grid-template-columns: 1fr;
      columns: 1;
    }
  }
</style>
