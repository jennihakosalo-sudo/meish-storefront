---
import Base from '../layouts/Base.astro';
import UniverseHero from '../components/UniverseHero.astro';
import PhilosophyFlap from '../components/PhilosophyFlap.astro';
---

<Base
  title="Meish — human experience is our North Star"
  description="Meish specialises in human experience — for business, spaces, gifts and custom tools. Possibility Map from 590 € + VAT."
>
  <section class="hero section">
    <div class="container container--wide hero__inner">
      <h1 class="hero__meish" aria-label="Meish">MEISH</h1>
      <p class="hero__subline">Meish for Your Business</p>
      <p class="hero__north-star">Human experience is our North Star.</p>
      <p class="hero__support">
        We specialise in human experience — making work and life clearer, smoother and more useful, and building the tools when the right ones do not exist yet.
      </p>
    </div>
  </section>

  <div class="container container--wide">
    <UniverseHero />

    <div class="motion-control">
      <button type="button" id="motion-stop" class="button button--motion" aria-pressed="false">
        STOP OBJECT MOTION
      </button>
    </div>

    <PhilosophyFlap />
  </div>

  <section id="review" class="door section">
    <div class="container">
      <p class="eyebrow">Door 1</p>
      <h2>Reviewing Human Experience</h2>
      <p class="lead">
        Experience Review (ExR) is our method for reading human experience in real places — what works, what frictions hide in plain sight, and what could be better.
      </p>
      <p>
        We observe, document and recommend. No new price on the homepage — contact us when you want a review for your space, event or service.
      </p>
      <a href="/services/experience-audits" class="button button--ghost">Learn about ExR</a>
    </div>
  </section>

  <section id="business" class="door section door--highlight">
    <div class="container">
      <p class="eyebrow">Door 2</p>
      <h2>Meish for Your Business</h2>
      <p class="lead">
        A clear map of your goals, skills, materials and next steps — before you commit to a big build.
      </p>

      <article class="offer-card">
        <h3>Possibility Map</h3>
        <p class="offer-card__price">590 € + VAT · Gamma Test Phase</p>
        <ul class="offer-card__list">
          <li>60-minute client interview</li>
          <li>Summary of goals, skills, materials and opportunities</li>
          <li>Visible Possibility Map</li>
          <li>Three different path options</li>
          <li>Recommendation for first implementation</li>
          <li>Practical guide for the next 30 days</li>
          <li>AI tools review — competitive edge, time saved, new business</li>
          <li>30-minute results walkthrough</li>
        </ul>
        <p class="offer-card__note">Delivery within five business days after the interview.</p>
        <div class="offer-card__actions">
          <a href="/universe/business/possibility-map" class="button button--primary">Explore Possibility Map</a>
          <a href="mailto:jenni@meish.work?subject=Possibility%20Map%20Fit%20Check" class="button button--ghost">Fit Check — jenni@meish.work</a>
        </div>
      </article>
    </div>
  </section>

  <section id="gifts" class="door section">
    <div class="container">
      <p class="eyebrow">Door 3</p>
      <h2>Meish Gifts</h2>
      <p class="lead">Thoughtful gifts and small rituals — moments that matter.</p>

      <article class="gift-card" id="rami-gift">
        <h3>RAMI — a name-giving ritual</h3>
        <p>
          RAMI is a session-only name ritual. Enter a name below and receive a short, personal reading — stored only in this browser session, never sent to a server.
        </p>
        <form class="rami-form" id="rami-form">
          <label for="rami-name">Name</label>
          <input type="text" id="rami-name" name="name" required maxlength="64" placeholder="Enter a name" />
          <button type="submit" class="button button--primary">Receive RAMI</button>
        </form>
        <output id="rami-result" class="rami-result" for="rami-name"></output>
      </article>
    </div>
  </section>

  <section id="tools" class="door section">
    <div class="container">
      <p class="eyebrow">Door 4</p>
      <h2>Meish Tools</h2>
      <p class="lead">
        We build custom tools when the right ones do not exist yet — always in service of human experience, never technology for its own sake.
      </p>
      <p><strong>Coming soon:</strong></p>
      <ul class="tools-list">
        <li>Elements</li>
        <li>Friction</li>
        <li>Fiction</li>
        <li>BA</li>
      </ul>
      <a href="/tools" class="button button--ghost">Tools overview</a>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('rami-form');
  const result = document.getElementById('rami-result');
  const storageKey = 'meish-rami-names';

  function ramiReading(name) {
    const vowels = (name.match(/[aeiouyäö]/gi) || []).length;
    const tone = vowels > name.length / 2 ? 'open and luminous' : 'grounded and deliberate';
    return `${name} carries a ${tone} quality — a name that invites presence. RAMI sees intention in how it is spoken aloud.`;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('rami-name');
    const name = input?.value.trim();
    if (!name || !result) return;
    const reading = ramiReading(name);
    result.textContent = reading;
    try {
      const stored = JSON.parse(sessionStorage.getItem(storageKey) || '[]');
      stored.push({ name, reading, at: Date.now() });
      sessionStorage.setItem(storageKey, JSON.stringify(stored.slice(-10)));
    } catch { /* session only */ }
  });

  try {
    const stored = JSON.parse(sessionStorage.getItem(storageKey) || '[]');
    const last = stored[stored.length - 1];
    if (last && result) result.textContent = last.reading;
  } catch { /* ignore */ }
</script>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
    text-align: center;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .hero__meish {
    font-family: var(--font-body);
    font-size: var(--text-meish);
    font-weight: var(--weight-black);
    letter-spacing: 0.06em;
    line-height: 0.9;
    color: var(--text);
    margin: 0;
    max-width: none;
  }

  .hero__subline {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-soft);
    max-width: none;
  }

  .hero__north-star {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--text);
    max-width: 28ch;
  }

  .hero__support {
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: 52ch;
    line-height: var(--leading-normal);
  }

  .motion-control {
    text-align: center;
    margin-block: var(--space-md) var(--space-xl);
  }

  .door {
    border-top: var(--border-hair);
  }

  .door--highlight {
    background: var(--accent-tint);
  }

  .offer-card {
    margin-top: var(--space-lg);
    padding: var(--space-xl);
    background: var(--surface);
    border: var(--border-hair);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .offer-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
  }

  .offer-card__price {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--accent);
    margin-bottom: var(--space-md);
    max-width: none;
  }

  .offer-card__list {
    margin: var(--space-md) 0;
    padding-left: 1.25rem;
    color: var(--text-soft);
    font-size: var(--text-sm);
  }

  .offer-card__list li { margin-bottom: var(--space-xs); }

  .offer-card__note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-lg);
    max-width: none;
  }

  .offer-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .gift-card {
    margin-top: var(--space-lg);
    padding: var(--space-xl);
    background: var(--surface);
    border: var(--border-hair);
    border-radius: var(--radius-lg);
  }

  .gift-card h3 {
    font-family: var(--font-display);
    margin-bottom: var(--space-sm);
  }

  .rami-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: flex-end;
    margin-top: var(--space-lg);
  }

  .rami-form label {
    width: 100%;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }

  .rami-form input {
    flex: 1;
    min-width: 12rem;
    padding: 0.75em 1em;
    border: var(--border-hair);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    background: var(--bg);
  }

  .rami-result {
    display: block;
    margin-top: var(--space-lg);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--text);
  }

  .tools-list {
    margin: var(--space-md) 0 var(--space-lg);
    padding-left: 1.25rem;
    color: var(--text-soft);
  }
</style>
