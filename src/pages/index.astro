---
import Base from '../layouts/Base.astro';
import LightHero from '../components/LightHero.astro';
import { becomeBetterHref, becomeBetterLabel } from '../data/hatchling-nav';
import { meishMailto } from '../lib/meish-mailto';

const mapMail = meishMailto({
  product: 'Possibility Map',
  page: 'Homepage',
  section: 'Offers',
  cta: 'Ask about Possibility Map',
});
---

<Base
  title="Meish — human experience is our North Star"
  description="Meish notices what needs to become better and turns it into useful products, tools and ways of working. Possibility Map €590 + VAT. English and Finnish."
  universeHome={true}
>
  <LightHero />

  <section class="block" aria-labelledby="arrive-title">
    <div class="container">
      <h2 id="arrive-title">Come with the situation</h2>
      <p class="intro">
        Meish starts by noticing. You can arrive with something unfinished — we do not expect you
        to name the service first.
      </p>
      <ul class="arrive">
        <li>“This is annoying.”</li>
        <li>“This takes too much time.”</li>
        <li>“Our customers keep getting confused here.”</li>
        <li>“I know a lot about this, but I don’t know how to sell it.”</li>
        <li>“We have an idea but no product.”</li>
        <li>“I don’t know what I need.”</li>
      </ul>
    </div>
  </section>

  <section class="block block--soft" id="pathways" aria-labelledby="pathways-title">
    <div class="container">
      <h2 id="pathways-title">How Meish works</h2>
      <p class="intro">
        Recognition before creation. Review before build. AI only after we know it should do the
        work at all.
      </p>
      <ol class="paths">
        <li id="review">
          <a href="/for-business#human-experience-review">
            <strong>Review</strong>
            <span>Understand what is actually happening — and what it feels like for the person moving through it.</span>
          </a>
        </li>
        <li id="improve">
          <a href="/for-business#friction-removal">
            <strong>Improve</strong>
            <span>Make something clearer, easier or less friction-heavy. Sometimes by removing it.</span>
          </a>
        </li>
        <li id="build">
          <a href="/for-business#build-with-meish">
            <strong>Build</strong>
            <span>Create something useful only when something genuinely needs to exist.</span>
          </a>
        </li>
        <li>
          <a href="/tools">
            <strong>Tools</strong>
            <span>Use a focused tool when a full project is unnecessary.</span>
          </a>
        </li>
        <li>
          <a href="#offers">
            <strong>Offers</strong>
            <span>Choose something already packaged — with a price, a scope and a next step.</span>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <section class="block" aria-labelledby="diff-title">
    <div class="container narrow">
      <h2 id="diff-title">What is different</h2>
      <p>
        Meish is not generic consulting or “AI services”. We look at the lived experience first —
        what it is actually like for the person moving through the work, the service or the day.
      </p>
      <p>
        Before we build, we ask whether something should be removed, simplified, reordered, left
        with a human, or given to a tool. Better does not necessarily mean more.
      </p>
      <p>
        From an interview we can turn messy knowledge into something usable — a clearer process, a
        product, a journey, or sales material. In a tightly scoped situation this can happen
        quickly. We do not promise that every idea becomes a business in one day.
      </p>
      <p>
        If the work frees time, we do not immediately fill it. Sometimes the useful next step is
        to enjoy doing nothing for a while.
      </p>
    </div>
  </section>

  <section class="block block--soft" aria-labelledby="who-title">
    <div class="container">
      <h2 id="who-title">Who it is for</h2>
      <div class="who">
        <a href="/for-business">
          <strong>Meish &amp; Your Business</strong>
          <p>
            Something is awkward, inefficient, unclear or simply not working as well as it could?
            Bring it to us.
          </p>
          <p class="who__meta">
            Customer experience · processes · products · services · communication · practical AI ·
            new business ideas
          </p>
          <span class="who__cta">Explore Meish &amp; Your Business →</span>
        </a>
        <a href="/for-you">
          <strong>Meish &amp; You</strong>
          <p>Something in your life, work or thinking could become clearer, easier or more useful?</p>
          <p class="who__meta">
            Decisions · transitions · self-guidance · family life · thinking tools · everyday friction
          </p>
          <span class="who__cta">Explore Meish &amp; You →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="block" id="offers" aria-labelledby="offers-title">
    <div class="container">
      <h2 id="offers-title">What you can get</h2>
      <article class="offer">
        <p class="eyebrow">Meish &amp; Your Business · Gamma Test Phase</p>
        <h3>Possibility Map</h3>
        <p>
          For a decision-maker who can see that something could work better — but not yet what to
          do. One interview. Then a visible map: three different routes, one recommendation, and
          practical next steps for 30 days. Delivered within five business days.
        </p>
        <p class="offer__price"><strong>€590 + VAT 25.5%</strong> · Regular €950 + VAT 25.5%</p>
        <p>
          <a class="button button--primary" href={mapMail}>Ask about Possibility Map</a>
        </p>
      </article>
      <article class="offer offer--quiet">
        <h3>20-minute Meish Fit Check</h3>
        <p>
          A short conversation to see whether Meish work would be useful in your situation. Not a
          physical fitness assessment.
        </p>
        <p class="offer__price"><strong>€0</strong></p>
        <p class="offer__routes">
          <a href="/contact">Meish &amp; You Fit Check</a>
          ·
          <a href="/contact">Meish &amp; Your Business Fit Check</a>
        </p>
      </article>
      <p class="more">
        More named work lives on
        <a href="/for-business">Meish &amp; Your Business</a>.
      </p>
    </div>
  </section>

  <section class="block block--soft" aria-labelledby="gifts-title">
    <div class="container">
      <h2 id="gifts-title">Useful things you can use without us</h2>
      <p>
        <a href="/gifts#clarity-starter"><strong>Meish Clarity Starter (PDF)</strong></a>
        — one page, five questions, one next move. Free. No signup.
      </p>
      <p>
        <a class="button button--ghost" href="/gifts/meish-clarity-starter.pdf">Download the PDF</a>
      </p>
    </div>
  </section>

  <section class="block block--end" aria-labelledby="end-title">
    <div class="container">
      <h2 id="end-title">Should we Meish this?</h2>
      <p>You can come with the situation. You do not have to come with the answer.</p>
      <p class="hero__actions">
        <a class="button button--primary" href={becomeBetterHref}>{becomeBetterLabel}</a>
        <a class="button button--ghost" href="/contact">20-min Meish Fit Check →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .block {
    padding: clamp(3.75rem, 8vw, 6.5rem) 0;
  }
  .block--soft {
    background: var(--color-cream);
  }
  .block--end {
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }
  h2 {
    margin: 0 0 1.75rem;
    max-width: 18ch;
  }
  .intro {
    margin: -0.5rem 0 2rem;
    font-size: 1.2rem;
    line-height: 1.6;
    max-width: 46rem;
  }
  .arrive {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    max-width: 40rem;
    font-size: 1.2rem;
    line-height: 1.55;
  }
  .paths {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.75rem 3rem;
  }
  @media (min-width: 800px) {
    .paths {
      grid-template-columns: 1fr 1fr;
    }
  }
  .paths a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .paths a:hover strong {
    color: var(--accent);
  }
  .paths strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.85rem);
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: 0.4rem;
  }
  .paths span {
    display: block;
    max-width: 36ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .who {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 800px) {
    .who {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }
  .who a {
    color: inherit;
    text-decoration: none;
  }
  .who strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    margin-bottom: 0.7rem;
    color: var(--color-navy);
  }
  .who p {
    margin: 0 0 0.85rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .who__meta {
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
  }
  .who__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1.0625rem;
    color: var(--color-navy);
  }
  .offer {
    max-width: 40rem;
  }
  .offer h3 {
    margin: 0.4rem 0 0.8rem;
    font-size: clamp(1.6rem, 2.4vw, 2rem);
  }
  .offer p {
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .offer__price {
    margin: 1rem 0 1.25rem;
  }
  .offer--quiet {
    margin-top: 3rem;
  }
  .offer__routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
  }
  .more {
    margin-top: 2.25rem;
    font-size: 1.125rem;
  }
  .narrow p {
    font-size: 1.2rem;
    line-height: 1.65;
  }
  .narrow p + p {
    margin-top: 1.15rem;
  }
  .block--end .hero__actions,
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.1rem;
    margin-top: 1.5rem;
    max-width: none;
  }
</style>
