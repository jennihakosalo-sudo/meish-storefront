---
/**
 * Privacy & boundaries.
 *
 * This page earns trust by being specific, not by being stirring. It previously
 * opened with "Trust is the product." at display size, which made a privacy
 * notice read as marketing; someone checking what happens to their data wants
 * the answer, not the conviction behind it. The boundaries are kept because
 * they are genuinely unusual commitments — they are just stated once, briefly.
 *
 * Only verified information appears here. Details still with legal review — the
 * registered data controller, exact retention periods, sub-processors — are
 * simply absent rather than guessed at or flagged as pending.
 */
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, mailTo } from '../data/site-content';

const boundaries = [
  ['No covert observation', 'People are never watched without knowing that observation is happening.'],
  ['No staff surveillance', 'We do not score, rank or profile individual employees.'],
  ['No individual scoring', 'We read patterns and situations, not people as targets.'],
  ['Findings stay with you', 'What we observe goes to the client organisation. It does not become public content.'],
  ['Sensitive data only with consent', 'And only where there is a clear reason to hold it at all.'],
];

const handling = [
  [
    'What we collect',
    'What you send us: your name, your email address and whatever you choose to write. The site itself sets no analytics or advertising cookies.',
  ],
  [
    'Why we hold it',
    'To answer you, and to carry out work you have asked for. Nothing else.',
  ],
  [
    'Who sees it',
    'The people doing your work. We do not sell it, share it or add you to a mailing list.',
  ],
  [
    'How long we keep it',
    'Enquiries that go nowhere are deleted once the conversation has clearly ended. Work materials are kept for the duration of the engagement and removed on request.',
  ],
  [
    'Your rights',
    'You can ask what we hold about you, ask for it to be corrected, or ask for it to be deleted. Consent, where we rely on it, can be withdrawn at any time.',
  ],
];
---

<Base
  title="Privacy & boundaries — Meish"
  description="What Meish collects, why, who sees it and how to have it removed. No covert observation, no staff surveillance, no individual scoring."
  noindex={false}
>
  <section class="head">
    <div class="container">
      <h1>Privacy &amp; boundaries</h1>
      <p class="head__lead">
        What we collect, why we hold it, and where we stop. If anything here is unclear, write to
        <a href={mailTo('Privacy question')}>{CONTACT_EMAIL}</a> and we will answer in plain language.
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="boundaries-title">
    <div class="container">
      <h2 id="boundaries-title">Where we stop</h2>
      <dl class="rows">
        {
          boundaries.map(([name, note]) => (
            <div class="rows__row">
              <dt>{name}</dt>
              <dd>{note}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="band band--soft" aria-labelledby="handling-title">
    <div class="container">
      <h2 id="handling-title">How we handle information</h2>
      <dl class="rows">
        {
          handling.map(([name, note]) => (
            <div class="rows__row">
              <dt>{name}</dt>
              <dd>{note}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="band" aria-labelledby="ask-title">
    <div class="container">
      <h2 id="ask-title">Ask us anything about this</h2>
      <p class="band__address">
        <a href={mailTo('Privacy question')}>{CONTACT_EMAIL}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 5vw, 3.75rem) clamp(1.25rem, 2.5vw, 1.75rem);
    background: var(--color-ivory);
  }
  /* Deliberately below the display scale used for the brand lines on the
     homepage and About. This is a page title, not a statement. */
  .head h1 {
    margin: 0;
    font-size: var(--text-page);
    font-weight: 400;
    letter-spacing: -0.004em;
  }
  .head__lead {
    margin: 1rem 0 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.6;
    max-width: 54ch;
    color: var(--color-ink-soft);
  }
  .head__lead a {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .band {
    padding-block: clamp(2.25rem, 5vw, 3.5rem);
  }
  .band--soft {
    background: var(--bg-alt);
    border-block: var(--border-hair);
  }
  .band h2 {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 400;
  }

  /* Term and explanation side by side so the page can be scanned down the
     left column and read only where it matters. */
  .rows {
    margin: 1.5rem 0 0;
  }
  .rows__row {
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    gap: 0.35rem 2.5rem;
    padding: 1rem 0;
    border-top: var(--border-hair);
  }
  .rows__row:last-child {
    border-bottom: var(--border-hair);
  }
  .rows dt {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }
  .rows dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text-soft);
    max-width: 60ch;
    text-wrap: pretty;
  }

  .band__address {
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    max-width: none;
  }
  .band__address a {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 0.22em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 46rem) {
    .rows__row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
