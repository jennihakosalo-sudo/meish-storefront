---
import Base from '../layouts/Base.astro';
import { fitCheckHref } from '../data/hatchling-nav';
---
<Base
  title="Meish Tools — start here | Meish"
  description="Meish Tools — start with the free Fit Check or explore Meish for Your Business offers."
>
  <section class="section container">
    <p class="eyebrow">Meish Tools</p>
    <h1>Start with one honest step</h1>
    <p class="lead">
      Meish Tools are focused instruments for human experience work. More tools are added over
      time — each one designed to improve your own, your team's, or your customers' experience.
    </p>

    <h2>Available now</h2>
    <ul>
      <li>
        <strong>Meish AI Fit Check</strong> — 20 minutes, free. Find the right first step.
      </li>
      <li>
        <strong>Meish for Your Business offers</strong> — Possibility Map, Build, Friction Removal
        and more.
      </li>
    </ul>

    <p>
      <a class="button button--primary" href={fitCheckHref}>Book a Fit Check</a>
      <a class="button button--ghost" href="/for-business">See business offers</a>
    </p>
  </section>
</Base>
