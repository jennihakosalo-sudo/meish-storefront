---
/**
 * Meish Tools.
 *
 * Visual character for this page is instrumentation: measured columns, index
 * marks, a ruled register. Tools are catalogued, not marketed.
 *
 * The Leadership Tool Sets are presentation only in this build — named,
 * priced and explained, with no checkout behind them. That is deliberate.
 */
import Base from '../layouts/Base.astro';
import { leadershipToolSets, getProduct } from '../data/meish-products';
import LightHero from '../components/LightHero.astro';
import { closing, contactAction, pageHeroes } from '../data/site-content';
import { writeDirectHref } from '../data/navigation';

const sets = leadershipToolSets;
const setProduct = getProduct('leadership-tool-sets')!;

/** Established tools only. Nothing invented for the sake of a fuller shelf. */
const tools = [
  {
    mark: '01',
    name: 'Points of Confusion → Presence',
    use: 'Find every moment where a person has to guess, and decide what to do with each one.',
    accent: 'var(--lucent-teal)',
  },
  {
    mark: '02',
    name: 'Arrival Experience',
    use: 'Walk the first ninety seconds of arriving somewhere, as the person arriving.',
    accent: 'var(--alignment-gold)',
  },
  {
    mark: '03',
    name: 'Sensory Walk',
    use: 'Move through a space recording only what you sense, before interpreting any of it.',
    accent: 'var(--resonance-violet)',
  },
  {
    mark: '04',
    name: 'Atmosphere Builder',
    use: 'Decide what a place should feel like, then work backwards to what produces that.',
    accent: 'var(--orbit-ember)',
  },
];
---

<Base
  title="Meish Tools — small instruments for one situation each"
  description="Small, practical, specific tools: Points of Confusion, Arrival Experience, Sensory Walk, Atmosphere Builder, and three Leadership Tool Sets from €49."
>
  <LightHero {...pageHeroes.tools} action={null} />

  <section class="band" aria-labelledby="register-title">
    <div class="container">
      <h2 id="register-title">The tools</h2>
      <ol class="register">
        {
          tools.map((t) => (
            <li class="tool" style={`--accent-node: ${t.accent}`}>
              <p class="tool__mark">
                <span class="tool__node" aria-hidden="true" />
                {t.mark}
              </p>
              <h3 class="tool__name">{t.name}</h3>
              <p class="tool__use">{t.use}</p>
            </li>
          ))
        }
      </ol>
      <p class="band__intro">
        More will appear here as they become genuinely usable by someone other than us. We do not
        publish empty shelves.
      </p>
    </div>
  </section>

  <section class="band band--soft" id="leadership-tool-sets" aria-labelledby="sets-title">
    <div class="container">
      <p class="band__eyebrow">{setProduct.price}</p>
      <h2 id="sets-title">Leadership Tool Sets</h2>
      <p class="band__intro">{setProduct.promise}</p>
      <p class="band__intro">
        Three sets, three tools each, one leadership skill per set. Made to be printed, filled in
        and argued with — not to be read. Choose the set by the skill you want to work on; the
        three tools in it are listed below.
      </p>

      <div class="sets">
        {
          sets.map((s) => (
            <article class="set" style={`--accent-node: ${s.accent}`}>
              <p class="set__label">
                <span class="set__node" aria-hidden="true" />
                Set
              </p>
              <h3 class="set__name">{s.name}</h3>
              <p class="set__skill">{s.skill}</p>
              <p class="set__contains">Three tools in this set</p>
              <ul class="set__tools">
                {s.tools.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <p class="band__note">
        These are not yet purchasable on the site. Write and we will send the set you want.
      </p>
      <p class="band__action">
        <a class="button button--primary" href={writeDirectHref}>Ask for a set</a>
      </p>
    </div>
  </section>

  <section class="band band--ink on-dark" aria-labelledby="which-title">
    <div class="container">
      <h2 id="which-title">Not sure which tool fits?</h2>
      <p class="band__intro">
        Often the honest answer is that no tool is needed and the situation just has not been
        described out loud yet. Write it down and send it — that is usually enough to tell.
      </p>
      <p class="band__brief">{closing.heading}</p>
      <p class="band__action">
        <a class="button button--primary" href={contactAction.href}>{contactAction.label}</a>
      </p>
    </div>
  </section>

</Base>

<style>
  .band {
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  .band--soft {
    background: var(--color-cream);
  }
  .band--ink {
    background: var(--meish-navy);
    color: var(--meish-ivory);
  }
  .band--ink :global(h2) {
    color: var(--meish-ivory);
  }

  .band h2 {
    font-weight: 400;
  }
  .band__eyebrow {
    margin: 0 0 0.7rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .band__intro {
    margin: 1.4rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.64;
    max-width: 52ch;
    color: var(--color-ink-soft);
  }
  .band--ink .band__intro {
    color: rgba(244, 239, 232, 0.86);
  }
  .band__note {
    margin: 2rem 0 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    max-width: 48ch;
  }
  .band__action {
    margin: 1.1rem 0 0;
    max-width: none;
  }
  .band__brief {
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--meish-ivory);
  }

  /* --- Tool register ------------------------------------------------------ */
  .register {
    list-style: none;
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
    padding: 0;
  }
  .tool {
    display: grid;
    grid-template-columns: 4rem minmax(0, 22rem) minmax(0, 32rem);
    gap: 0 2rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--color-line);
    align-items: start;
  }
  .tool:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .tool__mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding-top: 0.3em;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
    max-width: none;
  }
  .tool__node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-node);
    flex: none;
  }
  .tool__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.34;
    letter-spacing: 0;
  }
  .tool__use {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* --- Leadership sets ---------------------------------------------------- */
  .sets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem);
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .set {
    border-top: 1px solid var(--color-line-strong);
    padding-top: 1.1rem;
  }
  .set__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    max-width: none;
  }
  .set__node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-node);
    flex: none;
  }
  .set__name {
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  .set__skill {
    margin: 0.5rem 0 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  /* The list underneath is three named tools, not three features. Saying so
     stops it reading as a bullet list of claims. */
  .set__contains {
    margin: 1.1rem 0 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .set__tools {
    list-style: none;
    margin: 0.55rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-navy);
  }
  .set__tools li {
    position: relative;
    padding-left: 1.15rem;
  }
  .set__tools li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.66em;
    width: 0.55rem;
    height: 1px;
    background: var(--accent-node);
  }

  @media (max-width: 56rem) {
    .tool {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      padding-block: 1.35rem;
    }
    .tool__mark {
      padding-top: 0;
    }
  }
</style>
