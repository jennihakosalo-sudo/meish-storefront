---
import Base from '../layouts/Base.astro';
import DestinationMark from '../components/DestinationMark.astro';
import { fitCallHref, fitCallLabel } from '../data/hatchling-nav';
---
<Base
  title="Meish Tools — Meish"
  description="Meish Tools. Start with a 20-minute Fit Check, or see Meish for Your Business offers."
>
  <section class="section container door-page">
    <p class="eyebrow arrive">
      <DestinationMark size="page" />
      Tools
    </p>
    <h1>One honest next step</h1>
    <p class="lead">
      Tools exist to improve your own, your team’s, or your customers’ experience.
      Begin with a Fit Check, or go to the business offers.
    </p>

    <ul>
      <li>
        <strong>20-minute Fit Check</strong> — free. See whether there is something useful to do.
      </li>
      <li>
        <a href="/for-business"><strong>Meish for Your Business</strong></a> — Possibility Map and the other offers.
      </li>
    </ul>

    <p class="actions">
      <a class="button button--primary" href={fitCallHref}>{fitCallLabel}</a>
      <a class="button button--ghost" href="/for-business">See business offers</a>
    </p>
  </section>
</Base>

<style>
  .arrive {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
</style>
