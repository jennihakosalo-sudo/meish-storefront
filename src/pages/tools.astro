---
import Base from '../layouts/Base.astro';
import DestinationMark from '../components/DestinationMark.astro';
import { fitCallHref, fitCallLabel } from '../data/hatchling-nav';
---
<Base
  title="Meish Tools — start here | Meish"
  description="Meish Tools — focused instruments. Should We Meish This? 20 min · free, or Meish for Your Business offers."
>
  <section class="section container">
    <p class="eyebrow arrive">
      <DestinationMark kind="tools" size="page" />
      Meish Tools
    </p>
    <h1>Start with one honest step</h1>
    <p class="lead">
      You are in Tools. The instrument mark from the Universe is the same one as here.
      Each tool is made to improve your own, your team's, or your customers' experience.
    </p>

    <h2>Available now</h2>
    <ul>
      <li>
        <strong>Should We Meish This?</strong> — 20 minutes, free. Find the right first step.
      </li>
      <li>
        <a href="/for-business"><strong>Meish for Your Business</strong></a> — Possibility Map and the other offers.
      </li>
    </ul>

    <p>
      <a class="button button--primary" href={fitCallHref}>{fitCallLabel}</a>
      <a class="button button--ghost" href="/for-business">See business offers</a>
    </p>
  </section>
</Base>

<style>
  .arrive {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
</style>
